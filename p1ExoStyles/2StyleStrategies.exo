#------------------------------------
# Patterns
#------------------------------------

# Shared looks, named like the PoE2 ones. Theme Funcs and variant Expand blocks call them with the palette variables as arguments, so a palette edit still reaches every rule.
# An Expand block runs after the Func it extends: a command set there wins over the one the pattern call set.

Func BrickBlack(accent)
{
	SetTextColor sBlack; SetBorderColor sBlack; SetBackgroundColor accent;
}

Func BrickWhite(accent)
{
	SetTextColor sWhite; SetBorderColor sWhite; SetBackgroundColor accent;
}

Func BorderedGlow(accent, glow)
{
	SetTextColor accent; SetBorderColor accent; SetBackgroundColor glow;
}

Func Bordered(accent)
{
	SetTextColor accent; SetBorderColor accent;
}

Func ApexEffects()
{
	PlayAlertSound sounds.t1; PlayEffect tier.t1.cray; MinimapIcon 0 tier.t1.cmap tier.t1.icon;
}

Func SpecialGearEffects(mapsize)
{
	PlayAlertSound exoticgear.sound; PlayEffect exoticgear.cray; MinimapIcon mapsize exoticgear.cmap Diamond;
}

Func RecipeEffects()
{
	PlayAlertSound sounds.currency; PlayEffect recipe.cray; MinimapIcon 2 recipe.cmap Hexagon;
}

# This rule is applied to every single rule in the filter first.
Style UniversalPreProc
{
	Func ApplyToAll ()
	{
		SetBorderColor 0 0 0;
	}
}

Style UniversalHideLayer
{
	Func Any ()
	{
		SetBorderColor 0 0 0 0;
		SetBackgroundColor 0 0 0 0;
		MinimapIcon NONE;
		PlayEffect NONE;
		PlayAlertSound NONE;
		SetFontSize font.min;
		DisableDropSound True;
	}
}

Style UniversalValueAccents
{
	Func restex ()
	{ 
		SetFontSize font.max; 
		SetTextColor tier.error; SetBorderColor tier.error; SetBackgroundColor tier.error.low; 
		PlayAlertSound sounds.unique; PlayEffect tier.error.cray; MinimapIcon 0 tier.error.cmap icon; 
	}

	Func ClearBorder()
	{
		SetBorderColor NONE;
	}

}

