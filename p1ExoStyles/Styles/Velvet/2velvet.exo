# Theme overrides: only the themes whose look differs from the default
Expand currency_portal
{
    SetTextColor lowvaluecurrency;
}

Expand currency_portalleveling
{
    SetTextColor lowvaluecurrency;
}

Expand currency_portalstack
{
    BorderedGlow(lowvaluecurrency, sBlack);
}

Expand currency_t9
{
    Bordered(lowvaluecurrency);
}

