# Theme overrides: only the themes whose look differs from the default
Expand currency_lvlchance
{
    BorderedGlow(currency.acc.t5alchemy, currency.acc.t45extra);
}

Expand currency_lvlchaos
{
    BorderedGlow(currency.acc.t4chaos, currency.acc.t45extra);
}

Expand currency_lvlessence
{
    BorderedGlow(currency.acc.t5alchemy, currency.acc.t45extra);
}

Expand currency_portalstack
{
    SetFontSize 40;
}

