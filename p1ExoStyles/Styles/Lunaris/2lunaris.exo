{
    SetFontSize font.t4;
    BorderedGlow(currency.acc.t3annul, currency.acc.t3extra);
}

Expand currency_t4
{
    BorderedGlow(currency.acc.t4chaos, currency.acc.t45extra);
}

Expand currency_t5
