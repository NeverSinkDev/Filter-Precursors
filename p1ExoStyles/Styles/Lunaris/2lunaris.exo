{
    BorderedGlow(divi.acc.t4, sBlack);
}

Expand divination_t5
{
    SetBorderColor sBlack;
}

Expand divination_t5c
{
    SetBorderColor sBlack;
    SetFontSize NONE;
}

Expand exotics_t2
{
    SetFontSize 40;
}

Expand exotics_talismant3
{
    SetTextColor rares.jewellery.text;
}

Expand flasks_qualityhigh
{
    SetTextColor NONE;
}

Expand fragments_t1
{
    Bordered(fragment.tx);
}

Expand fragments_t2
{
    SetBackgroundColor fragment.tx;
}

Expand fragments_t3
{
    BorderedGlow(fragment.tx, fragment.acc.t3glow);
}

Expand fragments_t4
{
    BorderedGlow(fragment.tx, sBlack);
}

Expand fragments_t5
{
    SetFontSize font.t5;
    SetBorderColor 0 0 0;
    MinimapIcon NONE;
}

Expand fragments_t6
{
    SetFontSize font.t5;
    PlayEffect tier.t5.cray Temp;
}

Expand influenced_t1
{
    BorderedGlow(influenced.gear.t2, influenced.extra);
}

Expand influenced_t2
{
    BorderedGlow(influenced.gear.t3, sBlack);
}

Expand league_t2
{
    BorderedGlow(fragment.tx, tier.t2.extra);
    MinimapIcon 0 tier.t2.cmap Cross;
}

Expand league_t3
{
    SetFontSize font.t4;
    BorderedGlow(fragment.tx, sBlack);
    MinimapIcon 1 tier.t3.cmap Cross;
}

Expand league_t4
{
    Bordered(fragment.tx);
    MinimapIcon 2 tier.t4.cmap Cross;
}

