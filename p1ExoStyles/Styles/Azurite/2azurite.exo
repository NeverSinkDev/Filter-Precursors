Style StyleFixes
{
	Func FixMelee ()
	{
		SetBorderColor 0 0 0 255;
        SetBackgroundColor rares.jewellery.t1;
        SetTextColor 0 0 0 255;
	}
}

# Theme overrides: only the themes whose look differs from the default
Expand deco_rareilvl
{
    SetTextColor rares.text.i86p;
}

Expand deco_rareilvl68
{
    SetTextColor rares.text.i68p;
}

Expand deco_rareilvl75
{
    SetTextColor rares.text.i75p;
}

Expand deco_raretiny
{
    SetBorderColor rares.jewellery.border;
}

Expand exotics_talismant3
{
    SetTextColor sBlack;
}

Expand jewels_cluster
{
    SetBorderColor cluster.border;
}

Expand rares_jewelleryt1
{
    SetTextColor sBlack;
}

Expand rares_jewelleryt2
{
    SetTextColor sBlack;
}

Expand rares_jewelleryt3
{
    SetTextColor sBlack;
}

Expand uniques_heist
{
    SetBackgroundColor uniques.t2;
}

