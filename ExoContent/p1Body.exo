	Show t2	{ !currency_supply1; !G5H; %DS3;  StackSize >= 5; BaseType == currency.stacked.supplies.higher; }
	Show t3	{ !currency_supply1; !G6H;  %D3;  StackSize >= 3; BaseType == currency.stacked.supplies.higher; }
}

