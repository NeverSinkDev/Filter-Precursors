#===============================================================================================================
# [[4900]] Idols (Event Leagues Only)
#===============================================================================================================

Section EventIdols : Auto("event->idols")
{
	# 1x3 Idols
	Show MinorRare  	{ !league_t3; !G3; %H6; Rarity Rare; BaseType == "Minor Idol"; } 
	Show MinorMagic 	{ !league_t4; !G4; %H4; Rarity Magic; BaseType == "Minor Idol"; } 

	# 1x2 Idols
	Show KamasanRare 	{ !league_t3; !G3; %H6; Rarity Rare; BaseType == "Kamasan Idol"; } 
	Show KamasanMagic 	{ !league_t4; !G4; %H4; Rarity Magic; BaseType == "Kamasan Idol"; } 

	# 1x3 Idols
	Show TotemicRare 	{ !league_t3; !G3; %H6; Rarity Rare; BaseType == "Totemic Idol"; } 
	Show TotemicMagic 	{ !league_t4; !G4; %H4; Rarity Magic; BaseType == "Totemic Idol"; } 

	# 2x1 Idols
	Show NobleRare 		{ !league_t3; !G3; %H6; Rarity Rare; BaseType == "Noble Idol"; } 
	Show NobleMagic 	{ !league_t4; !G4; %H4; Rarity Magic; BaseType == "Noble Idol"; } 

	# 3x1 Idols
	Show BurialRare 	{ !league_t3; !G3; %H6; Rarity Rare; BaseType == "Burial Idol"; } 
	Show BurialMagic 	{ !league_t4; !G4; %H5; Rarity Magic; BaseType == "Burial Idol"; } 

	# 2x2 Idols
	Show ConquerorRare 	{ !league_t2; !G3; %H6; Rarity Rare; BaseType == "Conqueror Idol"; } 
	Show ConquerorMagic { !league_t4; !G4; %H5; Rarity Magic; BaseType == "Conqueror Idol"; } 

	# These should not exist
	Show NormalIdols { !exotics_t2; !GSH; Rarity Normal; Class == "Idols"; }
}

#===============================================================================================================
# [[4900]] Uniques
#===============================================================================================================
#!! Waypoint c10.uniques.all : "Tierlist - Uniques - All Tiering + Exceptions" : "Uniques"

Section Unique : Rarity Unique, Auto("uniques")
{

#------------------------------------
# [5701] Exceptions #1
#------------------------------------
	Show exUberImpresence { !apex_sunique; !G1; BaseType == "Onyx Amulet"; HasInfluence "Shaper"; HasInfluence "Elder"; }

	Show exKaom { !uniques_a; !G2; %H8; BaseType == "Glorious Plate"; Sockets < 1; }
## 	Show exSquire { !G1; BaseType == "Elegant Round Shield"; Sockets >= "3WWW"; }
	Show exTabula { !uniques_a; !G2; BaseType == "Simple Robe"; LinkedSockets 6; }
	Show exForgeSword { !apex_sunique; !G1; BaseType == "Infernal Sword"; HasInfluence "Shaper" "Elder"; }
	
	Show exRationalJewel  { !apex_sunique; !G1; BaseType == "Cobalt Jewel"; SynthesisedItem True; }
	Show exSynth  { !uniques_a; !G2; BaseType == uniques.exceptions.synthRings; SynthesisedItem True; }
	Show ex6link  { !uniques_a; !G1; LinkedSockets 6; }

	Show 4xabyssHelmet  { !apex_sunique; !G1; Sockets >= "AAAA"; BaseType == "Bone Circlet" }
	Show 3xabyss  { !apex_sunique; !G1; Sockets >= "AAA"; BaseType == "Carnal Armour" }

#------------------------------------
# [5702] Tier 1 and 2 uniques
#------------------------------------
#!! Waypoint c10.uniques.t1 : "Tierlist - Uniques - All tiering" : "Uniques"

	Show t1 { !apex_sunique; !G1; BaseType == uniques.generic.t1; }
	Show t2 { !uniques_a; !G2; %H8; BaseType == uniques.generic.t2; }	
#------------------------------------
# [5703] Exceptions #2
#------------------------------------
#!! Waypoint c10.uniques.undert1t2 : "Tierlist - Uniques - All tiering, except T1 and T2" : "Uniques"

	Show Vestige			{ !uniques_specmulti2; !GSH; %D9; Vestigial True; }
	Show exUniqueIdols		{ !uniques_specmulti1; !GSH; Class == "Idols"; }
	Show 2xcorrupteduniques { !uniques_spec2xcorr; !G2; Corrupted True; CorruptedMods >= 2; }
	Show 2xabyss 			{ !uniques_a; !G2; Sockets >= "AA"; BaseType == uniques.exceptions.abyssSocketUniques; }
	Show exCrucibleUnique 	{ !uniques_specmulti1; !GSH; HasCruciblePassiveTree True; }

#------------------------------------
# [5705] Multi-Unique bases.
#------------------------------------

	Show multispecialhigh { !uniques_specmulti1; !GSH; BaseType == uniques.generic.multispecialhigh; }

	ShowD exDust1 { !uniques_specdust; !G3; BaseType == uniques.ex.dust1 + uniques.ex.dust2; }
	ShowD exDust2 { !uniques_specdust; !G3; BaseType == uniques.ex.dust3; }
	ShowD exDust3 { !uniques_specdust; !G3; BaseType == uniques.ex.dust4; }

	Show foulBorn { !uniques_specmulti2; !GSH; %D9; Foulborn True; }
	Show multispecial { !uniques_specmulti1; !GSH; %H7; BaseType == uniques.generic.multispecial; }
	Show overQual { !uniques_specmulti1; !GSH; %D5; Quality >= 27; }
	Show 5link    { !uniques_spec5l; !GSH; %D4; LinkedSockets 5; }
	Show 6S 	  { !uniques_spec5l; !GSH; %D3; Sockets >= 6 }

#------------------------------------
# [5701] Low tier exceptions
#------------------------------------
#!! Waypoint c10.uniques.low : "Tierlist - Uniques - C Tier, Boss-Tier and lower" : "Uniques"

	Show earlyleague { !uniques_specearly; !G3; %H5; BaseType == uniques.generic.earlyleague; }
	ShowD recipeUniqueRings { !uniques_spec5l; !G5H; Class == "Rings"; }
	## Show mercUniques { !G3; %H5; BaseType == uniques.generic.mercUniques; }
	
	Show exjewelscorrupted    { !uniques_specjewelcorr; !GSH; BaseType == genericJewels; CorruptedMods = 0; Corrupted True; }
	Show exjewels    		  { !uniques_a; !GSH; BaseType == uniques.jewels; }
	
	ShowD highvinktar { !uniques_specearly; !G3; BaseType == "Imperial Staff"; ItemLevel >= 82; }
	
	Show  corrupteduniques { !uniques_spec1xcorr; !G4; %D5; Corrupted True; CorruptedMods >= 1; Class == classes_corrupted; }

#------------------------------------
# [5708] Tier 3 uniques 
#------------------------------------	
	Show t3boss {  !uniques_specboss; !G4; %H5; BaseType == uniques.generic.t3boss; }
	Show t3 	{  !uniques_b; !G4; %H4; BaseType == uniques.generic.t3; }
#------------------------------------
# [5709] Tier 4 uniques
#------------------------------------	
	Show hideable2 { !uniques_c; !G5H; %H3; BaseType == uniques.generic.hideable2; }
	Show hideable  { !uniques_c; !G5H; %H3; BaseType == uniques.generic.hideable; }
	Show restex { !utility_restex; Empty(); }
}

#===============================================================================================================
# [[4900]] Questlike-Items2
#===============================================================================================================

Section Questlike : Auto("Questlike"), !utility_quest
{
	Show Invitations { !QuestLike; BaseType "Maven's"; }
	Show LabyrinthConsumable { !QuestLike; Class == "Labyrinth Trinkets" "Labyrinth Items"; }
	Show IncursionConsumable { !QuestLike; Class == "Incursion Items"; }
}

#===============================================================================================================
# [[6000]] Hide outdated leveling flasks
#===============================================================================================================
#!! Waypoint c11.leveling.all : "Leveling - ALL rules" : "Leveling"

Section HideLayer3 : Auto("HideLayer"), Quality 0, Class == "Life Flasks" "Mana Flasks", !utility_layer
{
	Hide OutdatedLevelFlaskA { AreaLevel >= 15; BaseType "Large" "Medium" "Small"; }
	Hide OutdatedLevelFlaskB { AreaLevel >= 30; BaseType "Grand" "Greater"; }
	Hide OutdatedLevelFlaskC { AreaLevel >= 48; BaseType "Colossal" "Giant" "Sacred"; }
	Hide OutdatedLevelFlaskD { AreaLevel >= 60; BaseType "Hallowed" "Sanctified"; }
}

#===============================================================================================================
# [[6000]] Leveling - Utility Flasks and Tinctures
#===============================================================================================================
#!! Waypoint c11.leveling.utilflasks : "Leveling - Utility flasks and Quality Flasks" : "Leveling"

Func FlaskHighlight(level, b){ AreaLevel <= level; BaseType b; }

Section LevelingUtilityFlasks : Auto("Leveling->flasks->utility")
{
	Show Quicksilver 		{ !leveling_quicksilver; !G3; BaseType == "Quicksilver Flask"; }
	Show AsortedUtility 	{ !leveling_utilityflask; !G4; BaseType == bases.flask.utilityassorted; }
	Show Any 				{ !flasks_t3util; !G5; %H3; Class == class_utilFlasks; }
}

Section LevelingQualityFlasks : Auto("Leveling->flasks->quality"), Class == class_flasklikes
{
	Show max  { !flasks_qmax; !G5; %D3; Quality >= 20; Rarity <= Normal; }
	Show high { !flasks_qhigh; !G6; %D1; Quality >= 14; Rarity <= Magic; }
	Show any  { !leveling_qualityflask; !G7; %D0; Quality >= 1; Rarity <= Magic; }
}

Section LevelingTinctures : Auto("Leveling->tincture"), Class == "Tinctures", ItemLevel <= 67
{
	Show Any 				{ !leveling_utilityflask; !G4; Empty(); }
}

