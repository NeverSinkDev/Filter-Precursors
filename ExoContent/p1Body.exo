#===============================================================================================================
# [[6000]] Leveling - Rules
#===============================================================================================================
#!! Waypoint c11.leveling.gear.all : "Leveling - Gear - All non-unique" : "Leveling"

#------------------------------------
# [6002] Links and Sockets
#------------------------------------

Section LevelingLinksAndSockets : ItemLevel <= 67, Auto("Leveling->Rare->SocketsLinks"), Rarity Rare, !G5
{
	Show 4linkrares 			{ !leveling_4l; %D4; LinkedSockets >= 4; } 
}

#------------------------------------
# [6002] Rares - Exotics
#------------------------------------

Section Exotics : Auto("Leveling->Rare->Exotics"), Rarity <= Rare, ItemLevel <= 67
{
	Show MovementBootsHigh { !exotics_t2; !GSH; %D5; Class == "Boots"; Mod "Cheetah's" "Gazelle's" "Stallion's"; }
	Show MovementBootsLow { !exotics_t2; !GSH; %D5; Class == "Boots"; Mod "Sprinter's" "Runner's"; AreaLevel <= 40; }
	Show AnyVeiled 	{ !exotics_t3; !GSH; %D4; Identified True; Mod "Veil"; }
}

#------------------------------------
# [6002] Rares - Decorators
#------------------------------------
#!! Waypoint c11.leveling.decorators.all : "Leveling - Rares - Decorators" : "Leveling"

Section LevelingRareDecorator : Auto("Decorators->Leveling->Rare"), Rarity Rare, ItemLevel <= 67, !GEX
{
	Cont LargeRares 	{ !deco_rarelarge; Height >= 3; Width >= 2; }
	Cont MediumRares1 	{ !deco_raremedium; Height >= 3; Width = 1; }
	Cont MediumRares2 	{ !deco_raremedium; Height = 2; Width = 2; }
	Cont TinyRares 		{ !deco_raretiny; Height = 1; Width <= 2; }
}

#------------------------------------
# [6002] Rares - Universal
#------------------------------------
Section LevelingRareGear : Rarity Rare
{

#!! Waypoint c11.leveling.rares.minions : "Leveling - Rares - Minion Items" : "Leveling"
	Section Minion : Auto("Leveling->Rare->minion"), !GR2
	{
		Show General { !leveling_rareminion; %D4; BaseType == "Bone Ring" "Calling Wand" "Convening Wand" "Bone Spirit Shield" "Ivory Spirit Shield" "Fossilised Spirit Shield"; }
	}

#!! Waypoint c11.leveling.rares.trinkets : "Leveling - Rares - Belts, Rings, Amulets" : "Leveling"
	Section Universal : Auto("Leveling->Rare->universal"), !GRJ1
	{
		Show Jewellery  { !rares_t1jwlr; %D5; Class == classes_jewellery; }
	}

#!! Waypoint c11.leveling.rares.armors : "Leveling - Rares - Armour Pieces" : "Leveling"
	Section Armour : Auto("Leveling->Rare->armours"), !GR1
	{
		Show BootsFocus { !lvlmisc_rarearmourhigh; %D4; Class == "Boots"; }
		Show General 	{ !lvlmisc_rarearmour; %D4; Class == classes_armor_small; }
		Show BodyArmours{ !lvlmisc_rarebodyshield; %D4; Class == "Body Armours"; }
		Show Shields 	{ !lvlmisc_rarebodyshield; %D4; Class == "Shields"; }
		Show Quivers 	{ !leveling_rarearcher; %D4; Class == "Quivers"; }
	}

#------------------------------------
# [6002] Rares - Caster
#------------------------------------
#!! Waypoint c11.leveling.rares.caster : "Leveling - Rares - Caster" : "Leveling"
	Section Caster : Auto("Leveling->Rare->caster"), !leveling_rarecaster, !GR2
	{
		Show EarlyLevels { %D4; Class == classes_cast; ItemLevel <= 16; }
		Show General     { %D4; Class == classes_cast; }
	}

#------------------------------------
# [6002] Rares - Archer
#------------------------------------
#!! Waypoint c11.leveling.rares.archer : "Leveling - Gear - Archer" : "Leveling"
	Section Archer : Auto("Leveling->Rare->archer"), Class == "Bows", !leveling_rarearcher, !GR2
	{
		Show l1 { %D4; AreaLevel <= 25 }
		Show l2 { %D4; AreaLevel <= 30; DropLevel >= 10; }
		Show l3 { %D4; AreaLevel <= 35; DropLevel >= 15; }
		Show l4 { %D4; AreaLevel <= 45; DropLevel >= 20; }
		Show l5 { %D4; AreaLevel <= 55; DropLevel >= 25; }
		Show l6 { %D4; AreaLevel <= 60; DropLevel >= 30; }
		Show l7 { %D4; AreaLevel <= 65; DropLevel >= 35; }
		Show l8 { %D4; AreaLevel <= 70; DropLevel >= 40; }
	}

#------------------------------------
# [6002] Rares - Melee
#------------------------------------
#!! Waypoint c11.leveling.rares.melee : "Leveling - Gear - Melee" : "Leveling"

	Section Melee2H : Auto("Leveling->Rare->melee2h"), Class == classes_weapons_2hmelee, !leveling_raremelee2h, !GR2
	{
		Show l1 { %D4; AreaLevel <= 25 }
		Show l2 { %D4; AreaLevel <= 30; DropLevel >= 10; }
		Show l3 { %D4; AreaLevel <= 35; DropLevel >= 15; }
		Show l4 { %D4; AreaLevel <= 45; DropLevel >= 20; }
		Show l5 { %D4; AreaLevel <= 55; DropLevel >= 25; }
		Show l6 { %D4; AreaLevel <= 60; DropLevel >= 30; }
		Show l7 { %D4; AreaLevel <= 65; DropLevel >= 35; }
		Show l8 { %D4; AreaLevel <= 70; DropLevel >= 40; }
	}

	Section Melee1H : Auto("Leveling->Rare->melee1h"), Class == classes_weapons_1hmelee, !leveling_raremelee1h, !GR2
	{
		Show l1 { %D4; AreaLevel <= 25 }
		Show l2 { %D4; AreaLevel <= 30; DropLevel >= 10; }
		Show l3 { %D4; AreaLevel <= 35; DropLevel >= 15; }
		Show l4 { %D4; AreaLevel <= 45; DropLevel >= 20; }
		Show l5 { %D4; AreaLevel <= 55; DropLevel >= 25; }
		Show l6 { %D4; AreaLevel <= 60; DropLevel >= 30; }
		Show l7 { %D4; AreaLevel <= 65; DropLevel >= 35; }
		Show l8 { %D4; AreaLevel <= 70; DropLevel >= 40; }
	}

#------------------------------------
# [6002] Rares - Other
#------------------------------------
#!! Waypoint c11.leveling.rares.low : "Leveling - Gear - Low Tier" : "Leveling"

	Section Vendorable : Auto("Leveling->Rare->Remaining"), Class == classes_equip, !lvlmisc_rareunderlevel
	{
		ShowD ChromaticRares { !G5; %D3; SocketGroup "RGB"; }
		Show UnderLevel68 { !GR3; %D2; AreaLevel >=42; ItemLevel <= 68; }
		Show UnderLevel42 { !GR3; %D2; AreaLevel >=24; ItemLevel <= 44; }
		Show UnderLevel24 { !GR3; %D2; AreaLevel >=16; ItemLevel <= 26; }
		Show UnderLevel16 { !GR3; %D3; AreaLevel >=1;  ItemLevel <= 18; }
	}
}

#===============================================================================================================
# [[6400]] Leveling - Useful magic and normal items
#===============================================================================================================
#!! Waypoint c11.leveling.linked.all : "Leveling - Linked - 4link" : "Leveling"

#------------------------------------
# [6002] Purpose Picked Items
#------------------------------------
Section LevelingMiscGear : Rarity <= Magic
{
	Section FourLinkedGear : LinkedSockets >= 4, Auto("Leveling->NormalMagic->4L"), !G5
	{
		Show General { !leveling_4l; %D4; Empty(); }
	}

#!! Waypoint c11.leveling.rgb.all : "Leveling - Linked - RGB Recipe" : "Leveling"
	Section Chromatic : Auto("Leveling->NormalMagic->RGB"), SocketGroup "RGB", !G5
	{
		ShowD RGBSmall1	{ !links_recipe; %D5; Width 2; Height 2; }
		ShowD RGBSmall2	{ !links_recipe; %D5; Width 1; Height <=4; }
		ShowD RGBLarge	{ !leveling_rgb; %D4; Width 2; Height 4; }
		ShowD RGBMedium	{ !leveling_rgb; %D4; Width 2; Height 3; }
	}

#!! Waypoint c11.leveling.3linked.all : "Leveling - Linked - 3links" : "Leveling"
	Section ThreeLinkedGear : LinkedSockets >= 3, Auto("Leveling->NormalMagic->3L"), !G6H
	{
		Show EarlyThreeLinks 	{ !leveling_3l; %D3; AreaLevel <= leveling.keylevels.threelinkEarly; }
		Show General 			{ !leveling_3llow; %D2; AreaLevel <= leveling.keylevels.threelink; }
	}

#!! Waypoint c11.leveling.act12.all : "Leveling - Normal and Magic - Act1, Act2 special gear" : "Leveling"

	Section Act1 : AreaLevel <= leveling.keylevels.act1, Auto("Leveling->NormalMagic->act1"), !G6H
	{
		Show CasterWeapons { !leveling_casterweapon; %D4; Sockets >= 3; Class == "Wands" "Sceptres"; Rarity Magic; AreaLevel <= leveling.keylevels.act1; }
		Show CasterCraftRings { !leveling_act1; %D4; BaseType == leveling.bases.act1.craftrings; }
		Show General { !leveling_act1; %D4; BaseType == leveling.bases.act1.general; }
		Show Boots { !leveling_act1; %D4; Rarity Magic; Class == "Boots"; }
		Show Quivers { !leveling_rarearcher; %D4; Class == "Quivers" }
		Show Physical { !leveling_act1; %D4; BaseType == "Rustic Sash" "Iron Ring"; }
		Show Jewellery { !leveling_jewellery; %D4; Class == classes_jewellery; }
	}
	
	Section Act2 : AreaLevel >= leveling.keylevels.act1, AreaLevel <= leveling.keylevels.act2, Auto("Leveling->NormalMagic->act2"), !lvlmisc_otheracts, !G6
	{
		Show CasterCraftRings { %D3; BaseType == leveling.bases.act1.craftrings; }
		Show Physical { %D3; BaseType == "Rustic Sash"; }
	}

#!! Waypoint c11.leveling.actlater.all : "Leveling - Normal and Magic - Later Acts" : "Leveling"

	Section LaterActs : Auto("Leveling->NormalMagic->otheracts"), !lvlmisc_otheracts, !G7
	{
		Show HighPhysQuivers { %D2; BaseType == leveling.bases.quivers.best; }
		Show FireResistGear  { %D2; BaseType == "Ruby Ring"; AreaLevel >= leveling.keylevels.act2; AreaLevel <= leveling.keylevels.act6 }
		Show GeneralCrafting { %D2; AreaLevel >= leveling.keylevels.act2; BaseType == leveling.bases.generalcrafting; }
	}

	Section MinionItems : Auto("Leveling->NormalMagic->minion"), !lvlmisc_otheracts, !G7
	{
		Show  MinionGear      { %D2; BaseType == "Convoking Wand" "Calling Wand" "Convening Wand" "Bone Ring"; }
		ShowD MinionShields  { BaseType == "Bone Spirit Shield" "Ivory Spirit Shield" "Fossilised Spirit Shield"; }
	}
}

#------------------------------------
# [6002] Normals
#------------------------------------
#!! Waypoint c11.leveling.firstlevels.all : "Leveling - Normal and Magic - First Levels" : "Leveling"

Section FirstLevels : Auto("Leveling->FirstLevels")
{
	Show EarlyBodyArmours	{ !lvlmisc_progression; !GEX; %H2; AreaLevel >= 2; AreaLevel <= leveling.keylevels.start; Rarity Normal; Class == "Body Armours"; }
	Show ThreeSocketedGear 	{ !lvlmisc_3socketearly; !G6H; %H3; Rarity <= Magic; Sockets >= 3; AreaLevel <= leveling.keylevels.start; Class == "Boots" "Gloves" "Helmets" "Shields" "Wands" "Sceptres"; }
	Show FirstAreas 		{ !lvlmisc_firstareas; !G7; %H3; AreaLevel <= 4; Rarity Normal; }
}

#------------------------------------
# [6002] Weapon Progression
#------------------------------------
#!! Waypoint c11.leveling.progression.all : "Leveling - Normal and Magic - Item Progression" : "Leveling"

Func ProgressionRow (rar, il, dl){ ItemLevel <= il; DropLevel >= dl; Rarity <= rar; Sockets >= 3; }

Section WeaponProgression : Rarity Normal, Class == classes_weapons_melee classes_weapons_ranged, Auto("Leveling->WeaponProgression"), !lvlmisc_progression, !GEX
{
	Show r01 { %H2; ProgressionRow(Normal, 9,5); }
	Show r02 { %H2; ProgressionRow(Normal, 15,11); }
	Show r03 { %H2; ProgressionRow(Normal, 18,15); }
	Show r04 { %H2; ProgressionRow(Normal, 22,18); }
	Show r05 { %H2; ProgressionRow(Normal, 26,22); }
	Show r06 { %H2; ProgressionRow(Normal, 30,26); }
	Show r07 { %H2; ProgressionRow(Normal, 34,30); }
	Show r08 { %H2; ProgressionRow(Normal, 40,34); }
	Show r09 { %H2; ProgressionRow(Normal, 44,40); }
	Show r10 { %H2; ProgressionRow(Normal, 48,44); }
	Show r11 { %H2; ProgressionRow(Normal, 52,48); }
	Show r12 { %H2; ProgressionRow(Normal, 56,52); }
	Show r13 { %H2; ProgressionRow(Normal, 60,56); }
	Show r14 { %H2; ProgressionRow(Normal, 64,60); }
	Show r15Bas { %H2; ProgressionRow(Normal, 68,64); }
}

#------------------------------------
# [6002] Attack Wand Progression
#------------------------------------

Section WandProgression : Rarity Normal, Class == "Wands", Auto("Leveling->WandProgression"), !lvlmisc_progression, !GEX
{
	Show w1 { %H2; AreaLevel <= 24; BaseType == "Somatic Wand"; }
	Show w2 { %H2; AreaLevel <= 50; BaseType == "Blasting Wand"; }
	Show w3 { %H2; AreaLevel <= 67; BaseType == "Kinetic Wand"; }
}

#------------------------------------
# [6002] Remaining Magics
#------------------------------------

Section LevelingMagicDecorator : Auto("Decorators->Leveling->Magic"), ItemLevel <= 67, Rarity = Magic, !GEX
{
	Cont Medium1 { !deco_bluemedium; Height >= 3; Width = 1; }
	Cont Medium2 { !deco_bluemedium; Height = 2; Width = 2; }
	Cont NoticeEarly { !deco_bluemedium; AreaLevel <= leveling.keylevels.start; }
	Cont Tiny 	 { !deco_bluetiny; Height = 1; Width <= 2; }
}

#!! Waypoint c11.leveling.magicvendor.all : "Leveling - Normal and Magic - Magic Vendor Items" : "Leveling"

Section MagicItemsMisc : Auto("Leveling->Magic->Remaining"), Class == classes_equip, Rarity = Magic, !G7
{
	Section HideLayerMagicLeveling : !utility_layer
	{
		Hide LargeMagicBlocker  { AreaLevel >= leveling.keylevels.act1; Height >= 3; Width >= 2 }
		Hide MediumMagicBlocker { AreaLevel >= leveling.keylevels.act2; Height > 1; }
	}

	Show Rest 		 { !ClearBorder; %H1; AreaLevel >= leveling.keylevels.act3; AreaLevel <= 67; }
	Show Act2 		 { !lvlmisc_blueearly; !ClearBorder; %H2; AreaLevel >=leveling.keylevels.act1; AreaLevel <= leveling.keylevels.act2 ; }
	Show Act1 		 { !lvlmisc_blueearly; !ClearBorder; %H3; AreaLevel >=leveling.keylevels.start;  AreaLevel <= leveling.keylevels.act1; }
	Show UntilMudFlats { !lvlmisc_bluefirstzones; !ClearBorder; %H3; AreaLevel <= leveling.keylevels.firstZones; }
	Show FirstLevels   { !lvlmisc_bluefirstzones; !ClearBorder; %H3; AreaLevel >=1; AreaLevel <= leveling.keylevels.start; }
}

#!! Waypoint c12.hide.all : "HIDELAYER - Hide all known untiered items"

#------------------------------------
# [6002] Hide All known Section
#------------------------------------

Section HideLayerFinal : Auto("HideLayer")
{
	Hide Final { !utility_layer; Class classes_finalHider; }
}

#------------------------------------
# [6002] Show All unknown Section
#------------------------------------
#!! Waypoint c13.show.all : "SAFETYLAYER - Show all unknown items"

# THIS ENTRY IS CAUGHT IN 3 CASES:
# 1) YOUR FILTER IS OUT OF DATE!
# 2) YOU DID SOMETHING SILLY WHEN EDITING THE FILTER
# 3) YOU ENCOUNTERED A PREVIOUSLY UNKNOWN ITEM (VERY UNLIKELY)

Section AnyRemaining : Auto("AnyRemaining")
{
	Show restex { !utility_restex; Empty(); }
}
