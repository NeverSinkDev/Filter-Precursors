#!! Waypoint c9.currency.leveling.nonstacked : "Tierlist - Currency - Leveling Currency" : "Leveling"
Section LevelingCurrencies : Auto("Currency->Leveling"), Class == class_currency, AreaLevel <= 67
{
	Show essences { !currency_lvlessence; !G3; %D5;  BaseType currency.leveling.essences; }
	Show t1binding  { !currency_lvlchaos; !G3; %D5;  BaseType == currency.leveling.t1binding; }

	Show t2chance     { !currency_lvlessence; !G3; %D4;  BaseType == currency.leveling.t2gemCurrencyHigh; }
	Show t3transEarly { !currency_e; !G3; %D4;  BaseType == currency.leveling.t3gemCurrency; AreaLevel <= leveling.keylevels.act3; }
	Show t3trans 	  { !currency_supply2; !G5H; %D4; BaseType == currency.leveling.t3gemCurrency; }
	Show t4misc       { !currency_e; !G5; %D4;  BaseType == currency.leveling.t4quality; }
	Show t5aug        { !currency_supply2; !G5; %D4;  BaseType == currency.leveling.t5aug; }

	Show portal   { !currency_portalleveling; !G6H; %D4; BaseType == currency.leveling.portal; }
	Show wisdom   { !currency_wisdomlvl; !G6H; %D3; BaseType == currency.leveling.wisdom; }
}

