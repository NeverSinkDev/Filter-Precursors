#------------------------------------
# [4403] Map progression
#------------------------------------

#!! Waypoint c9.maps.generic.t16 : "Maps - t14-t16 - high reds" : "Maps"

		Show maps_a_t16 { !maps_t2; !GM1; MapTier >= 16; }
