Section Maps : Class == "Maps"
{
#------------------------------------
# [4405] SpecialMaps
#------------------------------------
	#!! Waypoint c9.maps.special.t17 : "Maps - Exceptional Types" : "Maps"
	Section ExoticMapTypes : Auto("maps->nightmare"), !maps_t1
	{
		Show ValdoMaps { !G2; %D8; BaseType == "Valdo Map"; }
		Show NightmareMaps { !G2; %D9; BaseType == "Nightmare Map"; }
		Show ShaperGuardianMaps { !G2; %D7; BaseType == "Shaper Guardian Map"; }
	}

#------------------------------------
# [4404] Blighted maps
#------------------------------------
#!! Waypoint c9.maps.special.all : "Maps - Blighted, Enchanted, Delirium maps" : "Maps"
	Section BlightedMaps : Auto("maps->blighted")
	{
		Show uber { !maps_t1exotic; !G2; UberBlightedMap True; }
		Show t1  { !maps_t1exotic; !G2; MapTier >= Maps.Blighted.HighTier; BlightedMap True; }
		Show Any { !maps_t2exotic; !G3; %H5; BlightedMap True; }
	}

#------------------------------------
# [4405] Special Maps
#------------------------------------

	Section VaalTemple : BaseType == "Vaal Temple Map", MapTier >= 16, Auto("maps->vaaltemple")
	{
		Show Any { !maps_t1; !G2; Empty(); }
	}

	Section SpecialCorruptedMaps : Auto("maps->corruptedspecial")
	{
		Show mod8 { !maps_t1exotic; !G2; Corrupted True; Identified True; Mod >=8 "a" "e" "i" "o" "u" "y"; }
	}

	Section EnchantedMaps : AnyEnchantment True, Auto("maps->enchanted")
	{
		Show t1  { !maps_t1exotic; !G3; %D6; MapTier >= Maps.Enchanted.HighTier }
		Show Any { !maps_t2exotic; !G4; %D5; Empty(); }
	}

	Section MapsWithCorruptedMods : Auto("maps->corruptedimplicit"), CorruptedMods >= 1
	{
		ShowD t1  { !maps_t1exotic; !G3; MapTier >= Maps.Enchanted.HighTier; Rarity Rare; }
		ShowD Any { !maps_t2exotic; !G4; %D6; Empty(); }
	}

	Section ImplicitModMaps : HasImplicitMod True, Auto("maps->implicitmod")
	{
		ShowD t1  { !maps_t1exotic; !G3; MapTier >= Maps.Enchanted.HighTier }
		ShowD Any { !maps_t2exotic; !G4; %D6; Empty(); }
	}

