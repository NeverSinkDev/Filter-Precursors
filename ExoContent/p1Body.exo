# [5104] Wombgifts
#------------------------------------

Section Wombgifts : Auto("exotic->wombgifts"), Class == "Wombgifts"
{
	## Wombgifts that are very expensive at level 84 (if any)
	Show t2ilvl84	{ !currency_a; !G1; ItemLevel >= 84; BaseType == bases.wombgifts.t2lvl84; }
	## Wombgifts that are very expensive BELOW itemlevel 69 (if any)
	Show t2ilvl68 { !currency_a; !G1; ItemLevel <= 68; BaseType == bases.wombgifts.t2lvl68; }

	Show t2	{ !currency_a; !G1; BaseType == bases.wombgifts.t2; }
	Show t3	{ !currency_b; !G3; %H8; BaseType == bases.wombgifts.t3; }
	Show t4	{ !currency_c; !G4; %H6; BaseType == bases.wombgifts.t4; }
	Show t5	{ !currency_e; !G5; %H4; BaseType == bases.wombgifts.t5; }
}

