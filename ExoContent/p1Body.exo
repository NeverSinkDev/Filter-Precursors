}

Section HeistContracts : Auto("Heist->Contract"), Class == "Contracts"
{
	Show Enchanted  { !exotics_t2; !GSH; %H7; BaseType == Heist.Contract.Handpicked; AnyEnchantment True; Rarity <= Rare; }
