Section HeistBlueprint : Auto("Heist->Blueprint"), Class == "Blueprints"
{
	Show Enchanted  { !exotics_t1; !GSH; %H9; AnyEnchantment True; Rarity <= Rare; }
	Show HandPicked { !maplike_t1; !G4; BaseType == Heist.Blueprint.Handpicked; }
