#===============================================================================================================
# [[3900]] Gem Tierlists
#===============================================================================================================
#!! Waypoint c8.gems.all : "Gem Rules - Override All" : "Gems"

Section Gems : Class == class_gems
{
#------------------------------------
# [3901] Exceptional Gems - Awakened and AltQuality
#------------------------------------
#!! Waypoint c8.gems.empowerclass : "Gem Rules - Empower Class" : "Gems"

	Section GemsExceptional : Auto("gems->exceptional")
	{
		var anySpecialGems = gems.tiered.t1 + gems.tiered.t2 + gems.tiered.t3 + gems.tiered.t4 - "Portal";

		Show highExceptionalBadCorrupt  { !gems_a; !G2; BaseType == gems.tiered.t1 + gems.tiered.t2; Quality <= 20; GemLevel <= 3; Corrupted True; }

		Show t1 { !apex_sgem; !G1; BaseType == gems.tiered.t1; }
		Show t2 { !gems_a; !G2; %H8; BaseType == gems.tiered.t2; }

		Show anyExceptionalLvl  { !gems_a; !G2; BaseType == anySpecialGems; GemLevel >= 2; }
		Show anyExceptionalQual { !gems_a; !G2; BaseType == anySpecialGems; Quality >= 10; }

		Show t3 { !gems_b; !G3; %H6; BaseType == gems.tiered.t3; }
		Show t4 { !gems_b; !G4; %H5; BaseType == gems.tiered.t4; }
	}

#------------------------------------
# [3901] Economy based leveled, quality and vaal gem rules
#------------------------------------
	Section GemsEcoGrowth : Auto("gems->special"), !gems_a
	{
		Show AltAny { !G2; TransfiguredGem True; }
		
		Show 2020z 	{ !G3; %D8; Quality >= 20; GemLevel >= 20; BaseType == gems.t2_2020z; Corrupted False; }
		Show xx20z 	{ !G3; %D8; Quality >= 19; BaseType == gems.t2_xx20z; Corrupted False; }
		Show 2120 	{ !G3; %D8; Quality >= 20; GemLevel >= 21; BaseType == gems.t2_2120 }
		Show 2023 	{ !G3; %D8; Quality >= 23; GemLevel >= 20; BaseType == gems.t2_2023 }
		Show 2123any { !G3; %D9; Quality >= 23; GemLevel >= 21; }
		Show xx23 	{ !G3; %D8; Quality >= 23; BaseType == gems.t2_xx23 }
		Show 21xx 	{ !G3; %D8; GemLevel >= 21; BaseType == gems.t2_21xx }

		## Quality Vaal gems worth leveling
		Show Vaal20 { !G2; %D6; Quality >= 20; BaseType == gems.t2_2020vaal }
	}

#------------------------------------
# [3902] High Quality and Leveled Gems
#------------------------------------
#!! Waypoint c8.gems.qualityandlevel : "Gem Rules - Quality and Leveled versions" : "Gems"

	Section GemsGeneric : Auto("gems->generic")
	{
		Show LT1 { !gems_b; !G3; %D7; GemLevel >= 21 }
		Show QT1 { !gems_b; !G3; %D7; Quality >= 23 }

		Show ex6lvlgems { !gems_b; !G3; BaseType == gems.untiered.sixlevelgems; GemLevel >= 6; }

		ShowD PlusOneGemCold  { !gems_plusone; !G4; Quality >= 5; BaseType == gems.plusone.cold ; }
		ShowD PlusOneGemFire  { !gems_plusone; !G4; Quality >= 5; BaseType == gems.plusone.fire ; }
		ShowD PlusOneGemLight { !gems_plusone; !G4; Quality >= 5; BaseType == gems.plusone.light ; }
		ShowD PlusOneGemChaos { !gems_plusone; !G4; Quality >= 5; BaseType == gems.plusone.chaos ; }
		ShowD PlusOneGemPhys  { !gems_plusone; !G4; Quality >= 5; BaseType == gems.plusone.phys ; }
		ShowD PlusOneGemMinion { !gems_plusone; !G4; Quality >= 5; BaseType == gems.plusone.minion ; }

		Cont DecoGemsVaalBgDrop { !gems_vaal; !GEX; BaseType "Vaal"; }

		Show QT2 { !gems_b; !G3; %D5; Quality >= 20 }
		Show LT2 { !gems_c; !G4; %D5; GemLevel >= 20 }

		Show QT3 { !gems_c; !G4; %D4; Quality >= 13 }
		Show LT3 { !gems_d; !G5; %D3; GemLevel >= 18 }

		Show QT4Lvl { !gems_c; !G5; %D4; Quality >= 1; AreaLevel >= 2; AreaLevel <= 67 }	
		Show QT4 { !gems_d; !G5; %D3; Quality >= 1; }	
		ShowD LT4 { !gems_d; !G6; %D0; GemLevel >= 2; }

#!! Waypoint c8.gems.low : "Gem Rules - First Zones, Leveling, Vaal" : "Gems"

		Show  FirstZone    { !gems_firstzone; !GS; AreaLevel 1; Quality = 0; GemLevel = 1; BaseType == gems.exleveling.one; }
		Show  LevelingVaal { !gems_vaallvl; !G4; %H4; AreaLevel >= 2; AreaLevel <= 67; BaseType "Vaal"; }
		Show  Leveling     { !gems_leveling; !G6; %H2; AreaLevel >= 2; AreaLevel <= 67; }

		Show CorruptedVaalAny { !gems_vaal; !G6H; %D3; BaseType "Vaal"; }

		Show any { !gems_rest; !G7; %H0; Empty(); }
	}
}

