
##~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
##   {META} FUNCTIONS
##~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

Func IdMods(){ Identified True; }
Func Clean(){ Corrupted False; Mirrored False; }
Func AnyInfluence() { HasInfluence Crusader Elder Hunter Redeemer Shaper Warlord; }

#===============================================================================================================
# [[0200]] Global overriding rules
#===============================================================================================================

#!! Waypoint c0.alpha : "All Rules - Highest priority - DANGER ZONE" : "Recipes and Linked Gear"

Section 6Links : Auto("6L"), LinkedSockets 6, Rarity <= Rare
{
	Show hightier { !links_6lt1; !G2; %D8; Clean(); BaseType == bases.sixlink.valuable.t1; ItemLevel >= 75; }
	Show others   { !links_6lt2; !G3; %D5; Empty(); }
}

#===============================================================================================================
# [[0200]] Gold
#===============================================================================================================

#!! Waypoint c0.gold : "All Rules - Including Gold" : "Gold"

Section Gold : Auto("Gold"), BaseType == "Gold"
{
	Show stack3 { !gold_huge; !G6; %H7; StackSize >= 3001; }
	Show stack2 { !gold_large; !G5; %H6;  StackSize >= 500; }
	Show stack1 { !gold_medium; !G6H; %H5; StackSize >= 150; }
	
	Show stacklvl1 { !gold_medium; !G5; %H5; StackSize >= 50; AreaLevel <= 68; }
	
	Show anyOther   { !gold_small; !G6H; %H4; Empty(); }
}

#===============================================================================================================
# [[0200]] Influenced Items
#===============================================================================================================

#------------------------------------
#   [1234] Influenced Maps
#------------------------------------

#!! Waypoint c1.infl.allplusmaps : "All rules - except gold and six-links" : "Maps"

Section InfluencedMaps : Auto("maps->influenced"), Class == "Maps"
{	
	HideD ZanaCorruptHider { !utility_shrunk; !GEX; !Shrink; ZanaMemory True; Rarity <= Magic; Corrupted True; }

	Show ZanaMap { !maps_t1; !G2; %H8; ZanaMemory True; Rarity <= Rare; MapTier >= 14; }
	Show ZanaMapLow { !maps_t2exotic; !G3; %H6; ZanaMemory True; Rarity <= Rare; }

	## Show InfShaper { !G2; %H7; HasInfluence Shaper; Rarity <= Rare; MapTier >= 14; }
	Show InfElder { !maps_t1; !G2; %H7; HasInfluence Elder; Rarity <= Rare; MapTier >= 16; }
	Show InfConquerors { !maps_t1; !G2; %H8; HasInfluence Crusader Hunter Redeemer Warlord; Rarity <= Rare; }
}

#------------------------------------
#   [1234] Influenced Gear
#------------------------------------

#!! Waypoint c1.infl.all : "All rules - except 6links and influenced maps" : "Gear - Exotic"

Section Influenced : Auto("influenced->all"), Rarity Rare
{
	var influencedItems2 = derived.rares.amurings.t1 + derived.rares.amurings.t2 + derived.rares.belts.t1 + derived.rares.belts.t2 + derived.crafting.shields.t1 + derived.crafting.shields.t2 + derived.crafting.quivers.t1 + derived.crafting.quivers.t2 + derived.crafting.quivers.t3 + "Stygian Vise";
	var influencedItems1 = bases.exotic.atlas.any + source.crafting.general.t1 - influencedItems2;
	var influencedItems3 = source.rares.eg.t2 + source.crafting.general.t2 - influencedItems2 - influencedItems1;

	# Selected exclusive bases
	Show t1exotic { !influenced_t1; !G2; %D9; BaseType == influencedItems1; AnyInfluence(); }
	# Selected top tier bases
	Show t1top { !influenced_t1; !G2; %D5; BaseType == influencedItems2; AnyInfluence(); }

	## BaseType filtering
	Show t1basesCrusader 		 	 { !influenced_t1; !G3; %D4; BaseType == Influenced.Crusader.t12; HasInfluence Crusader; ItemLevel >= 82; }
	Show t1basesWarlord 		 	 { !influenced_t1; !G3; %D4; BaseType == Influenced.Warlord.t12; HasInfluence Warlord; ItemLevel >= 82; }
	Show t1basesRedeemer 		 	 { !influenced_t1; !G3; %D4; BaseType == Influenced.Redeemer.t12; HasInfluence Redeemer; ItemLevel >= 82; }
	Show t1basesHunter 			 	 { !influenced_t1; !G3; %D4; BaseType == Influenced.Hunter.t12; HasInfluence Hunter; ItemLevel >= 82; }
	Show t1basesShaper 			 	 { !influenced_t1; !G3; %D4; BaseType == Influenced.Shaper.t12; HasInfluence Shaper; ItemLevel >= 82; }
	Show t1basesElder 			 	 { !influenced_t1; !G3; %D4; BaseType == Influenced.Elder.t12; HasInfluence Elder; ItemLevel >= 82; }

	## Class-based filtering
	Show t2classesCrusader 		 	 { !influenced_t2; !G3; %D4; Class == cInf1Crusader; HasInfluence Crusader; ItemLevel >= 80; }
	Show t2classesWarlord 		 	 { !influenced_t2; !G3; %D4; Class == cInf1Warlord; HasInfluence Warlord; ItemLevel >= 80; }
	Show t2classesRedeemer 		 	 { !influenced_t2; !G3; %D4; Class == cInf1Redeemer; HasInfluence Redeemer; ItemLevel >= 80; }
	Show t2classesHunter 			 { !influenced_t2; !G3; %D4; Class == cInf1Hunter; HasInfluence Hunter; ItemLevel >= 80; }
	Show t2classesShaper 			 { !influenced_t2; !G3; %D4; Class == cInf1Shaper; HasInfluence Shaper; ItemLevel >= 80; }
	Show t2classesElder 			 { !influenced_t2; !G3; %D4; Class == cInf1Elder; HasInfluence Elder; ItemLevel >= 80; }
	Show t2classesInfluencedShared 	 { !influenced_t2; !G3; %D4; Class == classesInfluenced85; AnyInfluence(); ItemLevel >= 85; }

	# Second grade bases
	Show t2high    { !influenced_t2; !G3; %D4; BaseType == influencedItems3; ItemLevel >= 84; AnyInfluence(); }
	# Low strictness 86 rule
	Show any86 { !influenced_t2; !G3; %D4; ItemLevel >= 86; AnyInfluence(); Class == classes_equip; }
	Show any   { !influenced_t2; !G3; %D3; AnyInfluence(); Class == classes_equip; }
}

#===============================================================================================================
# [[9999]] ELDRITCH ITEMS
#===============================================================================================================

#!! Waypoint c1.eldritch.all : "Eldritch Items - Exarch and Eater" : "Gear - Exotic"

Section Eldritch : Rarity <= Rare
{
	var eldritchBases = bases.eldritch.common.t1 + bases.eldritch.common.t2 + bases.eldritch.common.t3;

	Section Exarch : Auto("rare->exarch")
	{
		Show AnyHigh { !influenced_t2; !G3;  %D3; HasSearingExarchImplicit >= 1; BaseType == eldritchBases; }
		ShowD Any 	  { !influenced_t2; !GI; %D0; HasSearingExarchImplicit >= 1; }
	}

	Section Eater : Auto("rare->eater")
	{
		Show AnyHigh { !influenced_t2; !G3;  %D3; HasEaterOfWorldsImplicit >= 1; BaseType == eldritchBases; }
		ShowD Any 	  { !influenced_t2; !GI; %D0; HasEaterOfWorldsImplicit >= 1; }
	}
}

#===============================================================================================================
# [[0200]] Exotic Bases
#===============================================================================================================
#!! Waypoint c1.exotic.all : "Exotic - Expedition, Ritual, Kalandra etc" : "Gear - Exotic"

# These bases don't usually drop during normal gameplay and are usually only acquired form certain sources
# These are bases such as heist and ritual bases.

Section ExoticBases : Auto("ExoticBases"), Rarity <= Rare
{
	## TODO: == and + together mess up parsing

	Show EcoTinkBases84 { !apex_scurr; !G1; %D9; BaseType == bases.economy.tink; Clean(); ItemLevel >= 84; }
	Show EcoTinkBases   { !currency_a; !G2; %D9; BaseType == bases.economy.tink; Clean(); }

	Show ExoticHeistBases 	  { !exotics_t1; !GSH; %D9; BaseType == bases.exotic.heist.lower bases.exotic.heist.higher }
	Show ExoticRitualBases 	  { !exotics_t1; !GSH; %D8; BaseType == bases.exotic.ritual.any }
	Show ExoticLakeKala 	  { !exotics_t1; !GSH; %D9; BaseType == bases.exotic.lakeKala.any }
	Show ExoticExpeditionBases{ !exotics_t1; !GSH; %D8; BaseType == bases.exotic.expedition.any + "Iron Flask" }
	Show ExoticTalismanBases  { !exotics_t1; !GSH; %D9; $artefactex; BaseType == "Greatwolf Talisman"; }
	Show ExoticBasesMisc 	  { !exotics_t1; !GSH; %D9; BaseType == "Grasping Mail"; }
	Show ExoticUniqueBases	  { !exotics_t1; !GSH; %D6; BaseType == bases.exotic.misc.brickedUniques; }
}

#!! Waypoint c1.exotic.exclusivebases : "Exotic - Stygian, Cord Belts, Sarificial Garbs" : "Gear - Exotic"

Section ExoticBasesLower : Auto("ExoticBasesLower"), Rarity <= Rare, Clean()
{
	Show ExoticMirageBases { !exotics_t1; !GSH; %D9; BaseType == "Cord Belt"; }
	Show StygianMirage	   { !exotics_t1; !GSH; %D9; BaseType == "Stygian Vise"; Identified True; HasExplicitMod "Abyssal"; }
	Show Stygian86		   { !exotics_t1; !GSH; %D8; BaseType == "Stygian Vise"; ItemLevel >= 86; }
	Show Stygian		   { !exotics_t2; !GSH; %D5; BaseType == "Stygian Vise"; }
	
	Show ExoticSacrificial { !exotics_t3; !GSH; %D6; BaseType == "Sacrificial Garb"; }

	Show ExoticPearl { !exotics_t3; !GSH; %D5; BaseType == "Pearlescent Amulet"; }
}

#===============================================================================================================
# [[9999]] IDENTIFIED MOD FILTERING - COMBINATIONS
#===============================================================================================================
#!! Waypoint c1.idmod.all : "Identified Mods - Best Veiled mods and combinations of expensive ID mods" : "Gear - Exotic"

var t1veiled = "Elreon's Veiled";
var t2veiled = "Leo's Veiled" "Rin's Veiled" "Vagan's Veiled" "Vorici's Veiled" "Gravicius' Veiled" "Guff's Veiled" "Haku's" "It That Fled's Veiled" "Korell's Veiled" "of Aisling's Veil" "of Cameria's Veil" "of Hillock's Veil" "of Janus' Veil" "of Jorgin's Veil" "Riker" "Tora's Veiled";

Section IdModSection : IdMods(), Rarity "Rare", Auto("RareID"), !GSH 
{
#------------------------------------
#   [1234] Physical
#------------------------------------
	Section Weapons : Class == classes_attack, DropLevel >= 50, Mod xattackphys_Core, !idmods_high
	{
		Show Weapon_Phys     { %D5; Mod >= 3 xattackphys_Conf; Mod = 0 zbad_phys_attack; }
		Show Weapon_PhysPure { %D5; Mod >= 2 xattackphys_Conf; Mod = 0 zbad_phys_attack; Clean(); }
	}
#------------------------------------
#   [1234] Elemental
#------------------------------------
	Section FastEleWeapons : BaseType == bases.crafting.components.quickweapons.t1, Mod xattackele_Core, !idmods_high
	{
		Show Weapon_Ele 	{ %D5; Mod >= 4 xattackele_Norm; Mod = 0 zbad_ele_attack; }
		Show Weapon_ElePure { %D5; Mod >= 3 xattackele_Norm; Mod = 0 zbad_ele_attack; Clean(); }
	}
#------------------------------------
#   [1234] Blade Blast Daggers
#------------------------------------
	Section FastEleWeapons : Class == classes_bladeBlast, Clean()
	{
		Show BladeBlast_2core 	{ !idmods_high; %D4; Mod >=2 xbladeBlast_core; Mod >= 4 xbladeBlast_aux; }
	}
#------------------------------------
#   [1234] Gembased
#------------------------------------
	Section GemLevels : !idmods_high
	{
		Show Gem_Bow 	{ %D5; Class == "Bows"; Mod >=2 wgems_locallevelbow + ws_dot[1]; Clean(); }
		Show Gem_Caster { %D7; Class == classes_1hcast; Mod >=2 w_cheatmods + convokingLvl + w_temple_Caster + wgems_alllevels_global + wgems_alllevels_global; }
		Show Gem_Staves { %D7; Class == classes_2hcast; Clean(); Mod >=2 w_cheatmods + convokingLvl + w_temple_Caster + wgems_alllevels_staff + wgems_alllevels_staff_low; }
	}
#------------------------------------
#   [1234] Caster
#------------------------------------
	Section CasterSpecialized : Class == classes_1hcast, !idmods_high
	{
		Show Caster_FireWeaponT2  { %D5; Mod casterFireCore; Mod >= 4 xcaster_firedmg_norm; Mod = 0 z_bad_caster; }
		Show Caster_ColdWeaponT2  { %D5; Mod casterColdCore; Mod >= 4 xcaster_colddmg_norm; Mod = 0 z_bad_caster; }
		Show Caster_LightWeaponT2 { %D5; Mod casterLightCore; Mod >= 4 xcaster_lightdmg_norm; Mod = 0 z_bad_caster; }
		Show Caster_PhysWeaponT2  { %D5; Mod casterMiscPhys; Mod >= 4 xcaster_physdmg_norm; Mod = 0 z_bad_caster; }
		Show Caster_ChaosWeaponT2 { %D5; Mod casterMiscChaos; Mod >= 4 xcaster_chaosdmg_norm; Mod = 0 z_bad_caster; }
	}

	Section CasterMinion : BaseType == "Convoking Wand" "Convening Wand" "Calling Wand"
	{
		Show MinionWand { !idmods_high; %D5; Mod minionCore; Mod >= 4 mwAux; }
	}

#------------------------------------
#   [1234] Spellslinger
#------------------------------------
	Section Spellslinger : Class == "Wands"
	{
		Show Caster_SlingerT2 { !idmods_high; %D5; Mod slingerBase1; Mod >= 4 xslinger_default_conf; }
	}
#------------------------------------
#   [1234] Helmets
#------------------------------------
	Section Helmets : Class == "Helmets", !idmods_high
	{
		Show Helmet_Life_based { %D5; Mod xhelmet_life_core; Mod >= 4 xhelmet_life_mix; Mod = 0 z_bad_armor_life; Clean(); }
		Show Helmet_ES_based   { %D4; Mod >= 2 xhelmet_es_core; Mod >= 4 xhelmet_es_mix; Mod = 0 z_bad_armor_es; Clean(); }
	}
#------------------------------------
#   [1234] Boots
#------------------------------------
	Section Boots : Class == "Boots", !idmods_high
	{
		Show Boots_Life_based { %D5; Mod xboots_life_core; Mod >= 4 xboots_life_mix; Mod = 0 zbad_boots_life; }
		Show Boots_ES_based   { %D4; Mod xboots_es_core; Mod >= 4 xboots_es_mix; Mod = 0 zbad_boots_es + zbad_boots_life; Clean(); }
	}
#------------------------------------
#   [1234] Gloves
#------------------------------------
	Section Gloves : Class == "Gloves", !idmods_high
	{
		Show Gloves_Life_based { %D5; Mod xgloves_life_core; Mod >= 4 xgloves_life_mix; Mod = 0 z_bad_armor_life; }
		Show Gloves_ES_based   { %D5; Mod >= 2 xgloves_es_core; Mod >= 4 xgloves_es_mix; Mod = 0 zbad_boots_es; Clean(); }
	}
#------------------------------------
#   [1234] Shields
#------------------------------------			
	Section Shields : Class == "Shields", !idmods_high
	{
		Show Shield_ESFocus   		{ %D5; Mod >= 2 xshield_es_core; Mod >= 4 xshield_es_mix; Mod = 0 z_bad_bigarmor_es; }
		Show Shield_DefenseFocus    { %D5; Mod >= 2 xshield_defense_core; Mod >= 4 xshield_defense_mix; DropLevel >= 55; }
		Show Shield_CasterFocus   	{ %D5; Mod >= 2 xshield_caster_core; Mod >= 4 xshield_caster_mix; }
		Show Shield_LifeFocus 		{ %D5; Mod xshield_life_core; 	Mod >= 4 xshield_life_mix; DropLevel >= 55; Mod = 0 z_bad_bigarmor_life; }
	}
#------------------------------------
#   [1234] Amulets
#------------------------------------
	Section Amulets : Class == "Amulets", !idmods_high
	{
		Show Amu_exalter { %D5; Mod "Exalter's"; }

		Show Amu_1CoreCaster{ %D5; Mod xamu_singlecore; Mod >= 4 xamu_caster_mix; Mod = 0 z_bad_liferoll; }
		Show Amu_2CoreCaster{ %D5; Mod >= 2 xamu_multicore; Mod >= 4 xamu_caster_mix; }

		Show Amu_1CoreDot	{ %D5; Mod xamu_singlecore; Mod >= 4 xamu_dot_mix; Mod = 0 z_bad_liferoll; }
		Show Amu_2CoreDot	{ %D5; Mod >= 2 xamu_multicore; Mod >= 4 xamu_dot_mix; }

		Show Amu_1CoreAttack{ %D5; Mod xamu_singlecore; Mod >= 4 xamu_attack_mix; Mod = 0 z_bad_liferoll; }
		Show Amu_2CoreAttack{ %D5; Mod >= 2 xamu_multicore; Mod >= 4 xamu_attack_mix; }
	}
#------------------------------------
#   [1234] Rings
#------------------------------------
	Section Rings : Class == "Rings", !idmods_high
	{
		Show Ring_Caster { %D5; Mod xring_core; Mod >= 4 xring_cast_mix; Mod = 0 z_bad_liferoll; }
		Show Ring_Attack { %D5; Mod xring_core; Mod >= 4 xring_attack_mix; Mod = 0 z_bad_liferoll; }
		Show Ring_Light { %D5; Mod >= 2 xring_light_core; Mod >= 4 xring_light_aux; }
		Show Ring_Minion { %D5; BaseType == "Bone Ring"; Mod >= 2 ring_minion_high; Mod >= 4 xring_minion_mix; Mod = 0 z_bad_liferoll; }
	}
#------------------------------------
#   [1234] Quivers
#------------------------------------	
	Section Quivers : Class == "Quivers", !idmods_high
	{
		Show Quiv_Hit { %D5; Mod >= 2 xquiver_core_mods; Mod >= 4 xquiver_mix_hit; Mod = 0 z_bad_liferoll; }
		Show Quiv_Dot { %D5; Mod >= 2 xquiver_core_mods; Mod >= 4 xquiver_mix_dot; Mod = 0 z_bad_liferoll; }
	}
#------------------------------------
#   [1234] Body Armours
#------------------------------------	
	Section Body : Class == "Body Armours", DropLevel >= 55, Clean(), !idmods_high
	{
		Show Body_Life 		  { %D4; Mod xbody_core_life; Mod >= 5 xbody_aux_life; Mod = 0 z_bad_bigarmor_life; }
		Show Body_Defense 	  { %D4; Mod >= 2 xbody_core_defense; Mod >= 4 xbody_aux_life; }
		Show Body_LifeDefense { %D4; Mod >= 2 xbody_core_defense; Mod xbody_core_life; Mod >= 4 xbody_aux_life; }
		Show Body_ES 		  { %D4; Mod >= 2 xbody_core_es; Mod >= 4 xbody_aux_es; Mod = 0 z_bad_bigarmor_es; }
	}
#------------------------------------
#   [1234] Belts
#------------------------------------	
	Section Belts : Class == "Belts"
	{
		Show Belt_General {  !idmods_high; %D5; Mod xbelt_core; Mod >= 4 xbelt_mix; Mod = 0 z_bad_liferoll; }
	}
#------------------------------------
#   [1234] Jewels
#------------------------------------	
	Section Jewels : Class == class_jewels, !idmods_high
	{
		Show IdJewel_Minion 	{ %D7; Mod >= 2 xJwl_minion_core; Mod >= 3 xJwl_minion_mix; BaseType == genericJewels; }
		Show IdJewel_DOT 		{ %D7; Mod >= 1 xJwl_dot_core; Mod = 1 jwl_dot_unique; Mod >= 3 xJwl_dot_mix; BaseType == genericJewels; }
		Show IdJewel_CritAttack { %D7; Mod >= 1 xJwl_crit_core_attack;  Mod >= 2 xJwl_crit_subCore_attack; Mod >= 3 xJwl_crit_mix_attack; BaseType == genericJewels; }
		Show IdJewel_CritSpell 	{ %D7; Mod >= 1 xJwl_crit_core_spell; Mod >= 2 xJwl_crit_subCore_spell; Mod >= 3 xJwl_crit_mix_spell; BaseType == genericJewels; }

		Show IdAj_Attack  { %D7; Mod >= 1 xAj_core; Mod >= 3 xAj_attack_aux; BaseType == "Murderous Eye Jewel" "Searching Eye Jewel"; }
		Show IdAj_Caster  { %D7; Mod >= 1 xAj_core; Mod >= 3 xAj_caster_aux; BaseType == "Hypnotic Eye Jewel"; }
		Show IdAj_Minion  { %D7; Mod >= 1 xAj_core_minion; Mod >= 3 xAj_minion_aux; BaseType == "Ghastly Eye Jewel"; }
		Show IdAj_Mixer   { %D7; Mod >= 4 xAj_mixer_aux; BaseType == abyssJewels; }
	}

#------------------------------------
#   [1234] ID Mod exceptions - override id mod matching section
#------------------------------------
	Section IDModExceptions : Rarity "Rare", IdMods
	{
		Show t1veil     { !exotics_t1; !GSH; %D3; Mod t1veiled; }
		Show t2veil     { !exotics_t2; !GSH; %D0; Mod t2veiled; }
	}
}

#===============================================================================================================
# [[9999]] IDENTIFIED MOD FILTERING - DUAL MODS
#===============================================================================================================
#!! Waypoint c1.idmod.dualmod.all : "Identified Mods - Valuable Dual Mods" : "Gear - Exotic"

Section IdModSection : IdMods, Auto("RareBlendID"), Rarity <= Rare, Clean(), !idmods_medium, !GSH
{
	Show wCasterMin { %D5; Mod >= 3 wcast_top1; Class == classes_1hcast_shields; }
	Show wSmallArmorsBlend { %D5; Mod >= 3 armors_blend; Class == classes_armor_small; }
	Show wRingsBlend { %D5; Mod >= 3 rings_blend; Class == "Rings"; }
	Show wAmuletsBlend { %D5; Mod >= 3 amulets_blend; Class == "Amulets"; }
	Show wBeltsBlend { %D5; Mod >= 3 belts_blend; Class == "Belts"; }
	Show wEleAttackBlend { %D5; Mod >= 3 weapons_blend; Class == classes_weapons_ele; }
}

#===============================================================================================================
# [[9999]] IDENTIFIED MOD FILTERING - SINGLE MODS
#===============================================================================================================
#!! Waypoint c1.idmod.singlemod.all : "Identified Mods - Single Mods and low priority combinations" : "Gear - Exotic"

Section IdModSection : IdMods, Auto("MagicID"), !GSH
{
#------------------------------------
#   [1234] Top Value
#------------------------------------	

	Section TopValue : Rarity <= Rare, Clean(), !idmods_medium
	{
		## Tyrranical Physical Weapons
		Show t1phys 	{ %D5; Mod >= 1 wdmg_pphys[1]; Class == classes_attack + "Wands"; }
		## +1 to all global spell skill levels + convoking minion levels
		Show t1caster 	{ %D4; Mod >= 1 wgems_alllevels_global + convokingLvl; Class == classes_1hcast_shields; }
		## +2 proj ranged weapons
		Show t1proj 	{ %D5; Mod >= 1 "of Many"; Class == classes_weapons_ranged; }
		## plus one to all spell skills
		Show t1amu		{ %D8; Mod >= 1 "Exalter's" + xr_amu1 + acc_dot_mult[1]; Class == "Amulets"; }
		## plus 2 to minions helmet
		Show t1minionHelm	{ %D5; Mod >= 1 minionGems[1]; Class == "Helmets"; }
	}

#------------------------------------
#   [1234] Uncorrupted Mods
#------------------------------------	

	## In these cases we're looking for a singe high mod
	Section HighHybridPure : Clean(), Rarity <= Rare, !idmods_medium
	{
		## +1 to all global elemental gems and DOT t1
		Show t2amu			{ %D5; Mod >= 1 xr_amu1; Class == "Amulets"; }
		## +1 to all arrows quivers
		Show t2quiver 		{ %D5; Mod >= 1 xr_quiver1; Class == "Quivers"; }
		## Uncorrupted Suppression Gear from Dexterity Equip
		Show t2suppress    { %D4; Mod >= 1 "of Nullification"; Class == classes_armor_small; }
		## +1 to all global elemental gems + spell damage t1
		ShowD t2caster 		{ %D4; Mod >= 1 xr_caster1; Class == classes_1hcast_shields; }
		## +2 to all maximum resists shield
		ShowD t2shield		{ %D4; Mod >= 1 xr_shields1; Class == "Shields"; }
		## Uncorrupted Tyrranical weapons
		ShowD t2purephys 	{ %D4; Mod >= 1 wdmg_pphys[1] + wdmg_hphys[1]; Class == classes_attack; }
		## DOT Sceptres and Wands
		ShowD t2dotwand 	{ %D4; Mod >= 1 xr_caster_dot_wand; Class == "Wands" "Rune Daggers"; }
		ShowD t2sceptre 	{ %D4; Mod >= 1 xr_caster_dot_sceptre; Class == "Sceptres"; }
		## Elemental Weapons
		ShowD t2eleweapons 	{ %D4; Mod >= 1 xr_eleweapons1; Class == classes_weapons_ele; }
	}	

#------------------------------------
#   [1234] Flasks and Tinctures
#------------------------------------		

	Section FlaskAndTincture : Clean(), !idmods_high
	{
		Show bleedLifeFlask { !GSH; %D5; BaseType == "Divine Life Flask" "Eternal Life Flask"; Mod >= 2 flask_life_suffix + flask_life_prefix; }
		
		Show doubleModUtilFlask { !GSH; %D6; BaseType == bases.flask.utilityassorted; Mod >= 2 flask_util_suffix + flask_util_prefix; }
		Show singleModUtilFlask { !GSH; %D3; BaseType == bases.flask.utilityassorted; Mod >= 1 flask_util_suffix + flask_util_prefix; }
		
		Show doubleModTincture { !GSH; %D6; BaseType == bases.tinctures.t1; Mod >= 2 tincture_suffix + tincture_prefix; }
		Show singleModTincture { !GSH; %D4; BaseType == bases.tinctures.t1; Mod >= 1 tincture_suffix + tincture_prefix; }
	}
}

#===============================================================================================================
# [[9999]] High Priority Equipment Properties
#===============================================================================================================

#------------------------------------
# [1234] Perfection and Overquality Filtering
#------------------------------------
#!! Waypoint c3.gear.perfectionbased.all : "Crafting Bases - Perfection & Quality filtering" : "Gear - Exotic"

Section EndgamePerfectionItems : Auto("Crafting->QualityPerfection"), Clean()
{
	Show QualChancing { !exotics_t1; !G3; %D9; Quality >= 28; BaseType == "Riveted Boots" "Steel Kite Shield"; }

	var craftingArmors = derived.crafting.armors.t1 + derived.crafting.shields.t1 + derived.crafting.shields.t2 + bases.exotic.atlas.miscgear;
	Show armors1q1	{ !exotics_t1; !G1; %D9; Quality >= 28; Class == classes_armor; BaseType == craftingArmors; }
	Show armors1q2	{ !exotics_t2; !G2; %D8; Quality >= 24; Class == classes_armor; BaseType == craftingArmors; }

	Show weapont1q1 	 { !exotics_t1; !GEX; %D9; BaseType == derived.crafting.weapons.t1 + derived.crafting.weapons.t2; ItemLevel >= 83; Quality >= 28; }
	Show weapont2q1 	 { !exotics_t2; !GEX; %D8; BaseType == derived.crafting.weapons.t3; ItemLevel >= 83; Quality >= 28; }
	Show weapont1q2 	 { !exotics_t2; !GEX; %D8; BaseType == derived.crafting.weapons.t1 + derived.crafting.weapons.t2; ItemLevel >= 83; Quality >= 24; }
	Show weapont2q2 	 { !exotics_t2; !GEX; %D7; BaseType == derived.crafting.weapons.t3; ItemLevel >= 83; Quality >= 24; }
	
	Show anyOverQualityPerf  { !exotics_t2; !GEX; %D4; Class == classes_equip; Quality >= 30; }
	Show anyOverQualityHigh  { !exotics_t3; !GEX; %D3; Class == classes_equip; Quality >= 26; }
	ShowD anyOverQuality     { !exotics_t3; !GEX; %D0; Class == classes_equip; Quality >= 21; }

	ShowD PerfectionCrafting	 { !exotics_t2; !GEX; %D5; BaseDefencePercentile >= 99; Class == classes_armor; BaseType == craftingArmors; ItemLevel >= 84; }
}

#------------------------------------
# [1234] Memory Strand Gear
#------------------------------------
#!! Waypoint c3.gear.memorystrand.all : "Crafting Bases - Memory Stranded" : "Gear - Memory Stranded"

Section MemoryStrandEquip : Auto("gear->memorystrand"), Rarity <= Rare, Clean()
{
	var combinedt1gear = source.rares.eg.t1 + source.crafting.general.t1;
	var combinedt2gear = source.rares.eg.t2 + source.crafting.general.t2 - combinedt1gear;
	var combinedt3gear = source.rares.eg.t3 + source.crafting.general.t3 - combinedt2gear - combinedt1gear;

	Show strandedFractured { !exotics_t1; !G2; %D8; MemoryStrands >= 1; FracturedItem True; }
	Show strandedVeiled { !exotics_t1; !G2; %D8; MemoryStrands >= 1; Identified True; Mod "Veil"; }

	Show t1high { !exotics_t1; !G3; %D8; MemoryStrands >= 60; BaseType == combinedt1gear; }
	Show t1 	{ !exotics_t2; !G3; %D6; MemoryStrands >= 15;  BaseType == combinedt1gear; }

	Show t2high { !exotics_t2; !G3; %D5; MemoryStrands >= 60; BaseType == combinedt2gear; }
	Show t2 	{ !exotics_t3; !GSH; %D4; MemoryStrands >= 20;  BaseType == combinedt2gear; }

	Show t3high { !exotics_t2; !GSH; %D4; MemoryStrands >= 60; BaseType == combinedt3gear; }
	Show t3 	{ !exotics_t3; !GSH; %D2; MemoryStrands >= 25;  BaseType == combinedt3gear; }

	Show AnyHigh { !exotics_t2; !GSH; %D3; MemoryStrands >= 70; }
	Show Any 	 { !exotics_t4; !GSH; %D2; MemoryStrands >= 1; }
}

#===============================================================================================================
# [[9999]] IDENTIFIED MOD - CORRUPTED ITEMS
#===============================================================================================================
#!! Waypoint c1.idmod.corruptedmod : "Identified Mods - Items with corrupted implicits" : "Gear - Exotic"

Section IdModCorrupted : IdMods, Corrupted True, CorruptedMods 1, Auto("CorruptedID"), !exotics_t1corr
{
	Show Gloves_Life_based { !GS; %D4; Class == "Gloves"; Mod >= 1 xgloves_life_core; Mod >= 3 xgloves_life_mix; }
	Show Quiv_Hit { !GS; %D4; Class == "Quivers"; Mod >= 1 xquiver_core_mods; ItemLevel >= 80; Mod >= 3 xquiver_mix_hit; }
	Show Quiv_Dot { !GS; %D4; Class == "Quivers"; Mod >= 1 xquiver_core_mods; ItemLevel >= 80; Mod >= 3 xquiver_mix_dot; }
}

#===============================================================================================================
# [[0200]] Exotic Mods Filtering
#===============================================================================================================

var exotic_incursion = "Citaqualotl" "Guatelitzi" "Matatl" "Puhuarte" "Tacati" "Topotante" "Xopec";
var exotic_delve = "of the Underground" "Subterranean";
var exotic_warband = "Betrayer's" "Brinerot" "Deceiver's" "Mutewind" "Redblade" "Turncoat's";

var exotic_bestiary_t1 = "of Farrul" "of Fenumus";
var exotic_bestiary_t2 = "of Craiceann" "of Saqawal";

Section IdModSectionSpecial : IdMods
{
	Section Rare : Rarity "Rare", Auto("ExoticMods")
	{
#------------------------------------
#   [1234] Veiled/Betrayal - low prio veiled items
#------------------------------------
#!! Waypoint c1.idmod.veil.all : "Identified Mods - Low priority veiled items (not member specific)" : "Gear - Regular Rares"

		Show FracturedVeiled { !exotics_t2; !GSH; %D8; Clean(); Mod "Veil"; FracturedItem True; }
		Show FracturedIncursion { !exotics_t3; !GSH; %D7; Clean(); Mod exotic_incursion; FracturedItem True; }
		Show DuoVeil    { !exotics_t3; !GSH; %D4; Clean(); Mod "Veiled"; Mod "of the Veil"; }

#------------------------------------
#   [1234] Incursion/Temple Mods
#------------------------------------
#!! Waypoint c1.idmod.league.all : "Identified Mods - Incursion mod filtering" : "Gear - Exotic"

		Show IncursionSpeedTraps { !exotics_t2; !GSH; %D5; Mod "Matatl's"; Class == "Boots"; }
		Show IncursionCaster     { !exotics_t2; !GSH; %D5; Mod "Matatl's" "Tacati" "Topotante's"; Class == classes_cast_all; }
		Show IncursionElemental  { !exotics_t2; !GSH; %D5; Mod "Topotante's"; Class == classes_weapons_ele; }
		Show IncursionJwlry		 { !exotics_t2; !GSH; %D5; Mod exotic_incursion; Class == classes_jewellery; }
		Show IncursionGloveHelm  { !exotics_t2; !GSH; %D5; Mod "Puhuarte" "Topotante"; Class == "Gloves" "Helmets"; }
		Show IncursionAttack     { !exotics_t2; !GSH; %D5; Mod "of Tacati" "Tacati's"; Class == classes_attack; }
		Show IncursionLifeChest  { !exotics_t2; !GSH; %D4; Mod "Guatelitzi's"; Class == "Body Armours"; }
		Show IncursionMinion     { !exotics_t2; !GSH; %D4; Mod "Citaqualotl's"; Class == classes_cast + classes_1hattack; }
		Show IncursionMagic		 { !exotics_t3; !GS;  %D4; Mod exotic_incursion; Rarity Magic; }
		Show IncursionRandom     { !exotics_t3; !GS;  %D2; Mod exotic_incursion; }

#------------------------------------
#   [1234] Necropolis
#------------------------------------

		Show NecropolisCraft { !exotics_t2; !GSH; %D8; Mod "Haunted" "of Haunting"; }

#------------------------------------
#   [1234] Bestiary
#------------------------------------
		Show BestiaryValuable { !exotics_t2; !GSH; %D5; Mod exotic_bestiary_t1 }
		Show BestiaryOther    { !exotics_t3; !GSH; %D4; Mod exotic_bestiary_t2 }

#------------------------------------
#   [1234] Other
#------------------------------------
		Show DelveFractured    { !exotics_t1; !GSH; %D9; Mod exotic_delve; FracturedItem True; Rarity <= Rare; };
		Show Delve    { !exotics_t2; !GSH; %D8; Mod exotic_delve; Rarity <= Rare; };

		Show MercenaryOthers { !exotics_t2; !GSH; %D5; Mod mercMod; Rarity <= Rare; Class == classes_equipNoWeapons; };
		Show MercenaryWeapons { !exotics_t2; !GSH; %D5; Mod mercModWeapon; Rarity <= Rare; Class == classes_weapons_infamous; };

		Show Warband  { !exotics_t3; !GS;  %D3; Mod exotic_warband; Rarity <= Rare; };

		Show Essence  { !exotics_t4; !GSH; %D2; Mod "of the Essence" "Essences" };
		Show Crafting { !exotics_t4; !GS;  %D1; Mod "of Crafting" "of Spellcraft" "of Weaponcraft" };
	}
}

#===============================================================================================================
# [[0200]] Exotic Item Classes
#===============================================================================================================
#!! Waypoint c2.exotic.artefacts.all : "Exotic - Voidstones, Quest Items, Trinkets, Fishing items, Pieces" : "Gear - Exotic"

Section ArtefactItemClasses : Auto("artefact->misc"), !exotics_artefact
{	
	Show AnyImbued { !G3; Imbued True; }
	Show AnySynth   { !G3; SynthesisedItem True; Rarity <= Rare; }
	Show Voidstones { !G3; BaseType == exotic.voidstones.t1; }
	Show AnyTrinket { !G3; Empty(); Class == "Trinkets"; }
	Show FishingRods { !G1; Empty(); Class == "Fishing Rods"; }
	Show Pieces { !G3; Rarity "Unique"; Class == "Pieces"; }
}

Section QuestItemException : Auto("QuestlikeException"), !utility_quest
{
	Show QuestHeist { !QuestLike; BaseType "Contract:"; Class == "Quest Items"; }
	Show QuestItems { !QuestLike; Class == "Pantheon Souls" "Quest Items" "Cursed Ducat"; }
}

#------------------------------------
#   [1234] Relics
#------------------------------------	
Section SanctumRelics : Auto("artefact->sanctifiedrelics"), Rarity <= Rare
{
	Show SelectedRelics		{ !exotics_t2; !G3; %H9; Class == "Relics"; BaseType == exotic.sanctum.relics; }
	Show AnyRelic 			{ !exotics_t3; !G4; %H6; Class == "Relics"; }
}

#===============================================================================================================
# [[0200]] Exotic Item Variations
#===============================================================================================================
#!! Waypoint c2.exotic.doublecorrupted.all : "SpecialGear - Double corrupted rare items" : "Gear - Exotic"
Section ExoticVariations
{	
#------------------------------------
#   [1234] Double and Single Corruptions
#------------------------------------	
	Section RExoticVariations : Corrupted True, Auto("exotic->corruptions")
	{
			Show DoubleCorruptedJwlry { !exotics_t1corr; !GSH; %D8; Rarity Rare; CorruptedMods >= 2; Class == classes_doubleCorruptTargetsRare; }
			Show DoubleCorruptedAny   { !exotics_t2corr; !GS;  %D5; Rarity Rare; CorruptedMods >= 2; Empty(); }
#!! Waypoint c2.exotic.singlecorrupted.all : "SpecialGear - Single corrupted rare items with implicits"
			Show SingleCorruptedQuivers { !exotics_t3corr; !GS; %D2; CorruptedMods >= 1; Rarity <= Rare; Class == "Quivers"; ItemLevel >= 80; }
			Show SingleCorruptedItems { !exotics_t3corr; !GS; %D5; CorruptedMods >= 1; Rarity <= Rare; Class == "Rings"; ItemLevel >= 75; }
	}
#------------------------------------
#   [1234] Abyss Jeweled Rares
#------------------------------------	
#!! Waypoint c2.exotic.abysssocketed : "SpecialGear - Rares with Abyss Sockets" : "Gear - Exotic"

	Section NMRExoticVariations : Rarity <= Rare
	{
		Section AbyssJewelItems : SocketGroup "A", Auto("exotic->sockets")
		{
			Show AnyNonBelt { !exotics_t2; !GSH; Class == classes_nonJwlryEquipNoQuiv; }
		}

#------------------------------------
#   [1234] Fractured
#------------------------------------		
#!! Waypoint c2.exotic.fractured.all : "SpecialGear - All fractured items" : "Gear - Fractured and Synthesised"
		Section Fractured : FracturedItem True, Auto("exotic->fractured"), Clean()
		{
			Show FractT1 { !exotics_t2; !GSH; %D5; BaseType == bases.crafting.fractured.t1; }
			Show FractT2 { !exotics_t3; !GS;  %D4; BaseType == bases.crafting.fractured.t2; }
			Show FractT3 { !exotics_t3; !GS;  %D2; BaseType == bases.crafting.fractured.t3; }
			Show FractSpecial  { !exotics_t2; !GS;  %D6; Class == classes_fracturedExotic; }
			Show FractOthers { !exotics_t4; !GS;  %D2; }
		}
#------------------------------------
#   [1234] Enchanted
#------------------------------------
#!! Waypoint c2.exotic.enchanted.all : "SpecialGear - All enchanted items" : "Gear - Exotic"

		Section EnchantedMisc : AnyEnchantment True, Auto("exotic->enchanted")
		{
			Show Exotic      { !exotics_t1; !GSH; %D9; Class == classes_exoticEnch; }
			Show AnointedAmulets   { !exotics_t2; !GSH; %D7; Class == "Amulets"; BaseType == bases.generic.amulets.all; Clean(); }
			Show AnointedRings     { !exotics_t3; !GSH; %D3; Class == "Rings"; Clean(); }
		}
#------------------------------------
#   [1234] Crucible
#------------------------------------
#!! Waypoint c2.exotic.others : "SpecialGear - Others exotic items" : "Gear - Exotic"
		Section Crucible : HasCruciblePassiveTree True, Auto("exotic->crucible")
		{
			Show CrucibleAny   { !exotics_t3; !GS;  %D3; Empty(); }
		}
	}
}

#===============================================================================================================
# [[0200]] Recipes and 5links
#===============================================================================================================
#!! Waypoint c3.gear.alllinks.all : "SpecialGear - 5-links and 6-socketed items" : "Recipes and Linked Gear"

#------------------------------------
# [1234] Link Based
#------------------------------------

Section SocketsLinks : Rarity <= Rare, Auto("SocketsLinks")
{
	## ShowD 4Offcolors { !GS; %D4; Class == classes_fourSocketPlus; Sockets >= 4; Sockets <= 1W; }

	Show 5LinksLeveling	{ !leveling_5l; !G3; %D4; LinkedSockets >= 5; AreaLevel >= 2; AreaLevel <= 67; }
	Show 5Link6Sockets	{ !links_6s5l; !G5H; %D4; Sockets >= 6; LinkedSockets >= 5; }
	Show 5Links			{ !exotics_t3; !GS; %D3; LinkedSockets >= 5; AreaLevel >= 68; }

	Show RGBSmall1	{ !links_recipe; !G5H; %D5; SocketGroup "RGB"; Width 2; Height 2; }
	Show RGBSmall2	{ !links_recipe; !G5H; %D5; SocketGroup "RGB"; Width 1; Height <=4; }
	Show RGBLarge	{ !links_recipe; !G5H; %D3; SocketGroup "RGB"; Width 2; Height 4; }
	Show RGBMedium	{ !links_recipe; !G5H; %D4; SocketGroup "RGB"; Width 2; Height 3; }

	Show 6Sockets4H		{ !links_recipe; !G5H;  %D3;  Sockets >= 6; Height = 4; }
	Show 6Sockets		{ !links_recipe; !G5H; %DS3; Sockets >= 6; Height = 3; }
}

#===============================================================================================================
# [[0200]] High Level Crafting Bases
#===============================================================================================================
#!! Waypoint c3.gear.valuableilvl86 : "Crafting Bases - ilvl86 crafting bases" : "Gear - Crafting Bases"

#------------------------------------
# [1234] Expensive Atlas 86 Bases - matched by economy
#------------------------------------

Section Valuable : Clean(), Auto("Crafting->Expensive"), Rarity <= Rare, !exotics_t1
{
	Show Any86 { !GSH; %D5; BaseType == expensivebases.any86; ItemLevel >= 86; }
	Show Any85 { !GSH; %D5; BaseType == expensivebases.any85; ItemLevel >= 85; }
	Show Any84 { !GSH; %D5; BaseType == expensivebases.any84; ItemLevel >= 84; }
	Show Any83 { !GSH; %D4; BaseType == expensivebases.any83; ItemLevel >= 83; }
}

#===============================================================================================================
# [[0200]] Endgame - Rare - Gear
#===============================================================================================================
#!! Waypoint c4.rare.decorator.all : "Rare Endgame Items - decorators"

#------------------------------------
# [[0200]] Endgame - Rare - Decorators
#------------------------------------
Section RareDecorators : Auto("Decorators->rareeg"), Rarity Rare, ItemLevel >= 68, !GEX
{
	Cont LargeRares 	{ !deco_rarelarge; Height >= 3; Width >= 2; Class == classes_equip; }
	Cont MediumRares1 	{ !deco_raremedium; Height >= 3; Width = 1; Class == classes_equip; }
	Cont MediumRares2 	{ !deco_raremedium; Height = 2; Width = 2; Class == classes_equip; }
	Cont TinyRares 		{ !deco_raretiny; Height = 1; Width <= 2; Class == classes_equip; }

	ContD ILVL68 { !deco_rareilvl68; ItemLevel >= 68; Class == classes_equip; }
	ContD ILVL75 { !deco_rareilvl75; ItemLevel >= 75; Class == classes_equip; }

	Cont FourLinkedRares 	{ !deco_rare4l; LinkedSockets >= 4; Class == classes_equip; }

	Cont TopILVL83 { !deco_rareilvltop; ItemLevel >= 83; Class == cTop83; }
	Cont TopILVL84 { !deco_rareilvltop; ItemLevel >= 84; Class == cTop84; }
	Cont TopILVL85 { !deco_rareilvltop; ItemLevel >= 85; Class == cTop85; }
	Cont TopILVL86 { !deco_rareilvltop; ItemLevel >= 86; Class == cTop86; }
	
	Cont CorruptedRares { !deco_rarecorr; Corrupted True; CorruptedMods 0; Class == classes_equip; }
	Cont CorruptedRaresImplicit { !deco_rarecorrimp; Corrupted True; CorruptedMods >= 1; Class == classes_equip; }
}

#!! Waypoint c4.rare.talisman.all : "Rare Endgame Items - Talismans" : "Gear - Exotic"

Section Talismans : Class == "Amulets", AnyEnchantment True, Auto("rare->exotic->talisman"), ItemLevel >= 68, Rarity <= Rare
{
	Show T1 { !exotics_t1; !G3; %H8; BaseType == source.rares.talisman.t1; }
	Show T2 { !exotics_t2; !G3; %H6; BaseType == source.rares.talisman.t2; }
	Show T3 { !exotics_t3; !G4; %H4; BaseType == source.rares.talisman.t3; }
}

## Visualizes items dropped by necropolis crafting by using the arealevel
Section CraftingItemHighlight : Rarity Rare, AreaLevel 1, ItemLevel >= 4, Identified True, Auto("rare->utility->droppeditems"), Class == classes_equip
{
	ShowD Any  { !utility_droppeditems; !GR1; Empty(); }
}

Section EndgameRares : Rarity Rare, ItemLevel >= 68
{
#------------------------------------
# [[0200]] Endgame - Rare - Exotic Veiled
#------------------------------------
#!! Waypoint c4.rare.veiled.generic : "Rare Endgame Items - Veiled" : "Gear - Veiled"

	Section VeiledRares : Rarity Rare, ItemLevel >= 68, Auto("rare->exotic->veiled"), Identified True, Mod "Veil"
	{
		Show t1 	{ !exotics_t2; !G3; %D4;  BaseType == source.rares.eg.t1; }
		Show t2		{ !exotics_t3; !G4; %D3;  BaseType == source.rares.eg.t2; }
		Show t3 	{ !exotics_t3; !G5; %D3;  BaseType == source.rares.eg.t3; }
		Show t4 	{ !exotics_t4; !GSH; %D2; BaseType == source.rares.eg.t4; }
		Show Any 	{ !exotics_t4; !GSH; %D1; Empty(); }
	}

#------------------------------------
# [[0200]] Endgame - Rare - Exotic Corrupted
#------------------------------------
#!! Waypoint c4.rare.breach.all : "Rare Endgame Items - Breach rings" : "Gear - Exotic"

	Section BreachRings : Class == "Rings", BaseType == bases.extoic.misc.breachring, Auto("rare->exotic->breachrings"), Rarity <= Rare, !exotics_t2
	{
		Show High { !G4; %HS6; ItemLevel >= 82; }
		Show Any  { !G5; %HS5; Empty(); }
	}

#------------------------------------
# [[0200]] Endgame - Rare - Conditional Hide Rules
#------------------------------------
#!! Waypoint c4.rare.generic.all : "Rare Endgame Items - (Optional) Hiding identified rares"

	Section OptionalRare : Auto("RareOptional")
	{
		HideD IdHider { !utility_shrunk; !GEX; !Shrink; Identified True; Class == classes_equip; }
	}

#!! Waypoint c4.rare.corrupthider : "Hide rare corrupted unidentified gear with no implicits"

Section ConditionalRareHider : Auto("HideLayer"), !utility_shrunk
{
	Hide CorruptedRares { !shrink; Corrupted True; CorruptedMods 0; Identified False; Class == classes_nonJwlryEquip; }
	Hide MirroredRares { !shrink; Mirrored True; CorruptedMods 0; Identified False; Class == classes_nonJwlryEquip; }
}

#------------------------------------
# [[0200]] Endgame - Rare - Amulets, Rings, Boots
#------------------------------------
#!! Waypoint c4.rare.trinkets.all : "Rare Endgame Items - Amulets, Rings" : "Gear - Regular Rares"

	Section EndgameRareRingsAmulets : Class == "Rings" "Amulets", Auto("rr->amuring")
	{
		Show T1 { !rares_t1jwlr; !GRJ1; %D4; BaseType == derived.rares.amurings.t1; }
		Show T2 { !rares_t2jwlr; !GRJ2; %D3; BaseType == derived.rares.amurings.t2; }
		Show T3 { !rares_t3jwlr; !GRJ3; %D2; BaseType == derived.rares.amurings.t3; }
	}

#!! Waypoint c4.rare.belts.all : "Rare Endgame Items - Belts" : "Gear - Regular Rares"
	Section EndgameRareBelts : Class == "Belts", Auto("rr->belts")
	{
		Show T1 { !rares_t1jwlr; !GRJ1; %D4; BaseType == derived.rares.belts.t1; }
		Show T2 { !rares_t2jwlr; !GRJ2; %D3; BaseType == derived.rares.belts.t2; }
		Show T3 { !rares_t3jwlr; !GRJ3; %D2; BaseType == derived.rares.belts.t3; }
	}

#------------------------------------
# [[0200]] Endgame - Rare - Gear - Droplevel Hiding
#------------------------------------

#!! Waypoint c4.rare.drophiders : "Rare Endgame Items - Hide low items on high levels" : "Gear - Regular Rares"

	Section HideLayerRareRuleIncremental : Auto("HideLayer"), !utility_layer
	{
		Hide RRIHide1 { %RH3; AreaLevel >= 82; DropLevel < 75; Class == classes_armor_noshields; }
		Hide RRIHide2 { %RH2; AreaLevel >= 80; DropLevel < 60; Class == classes_armor_noshields; }
		Hide RRIHide3 { %RH2; AreaLevel >= 78; DropLevel < 50; Class == classes_armor_noshields; }
		Hide RRIHide4 { %RH1; AreaLevel >= 73; DropLevel < 40; Class == classes_armor_noshields; }
	}

#------------------------------------
# [1234] Endgame - Rare - Gear
#------------------------------------

#!! Waypoint c4.rare.t1.all : "Rare Endgame Items - T1" : "Gear - Regular Rares"

	Section EndgameRareGear : Auto("rr")
	{
		Show T1 { !rares_t12; !GR1; %D4; BaseType == derived.rares.gear.t1; }

#!! Waypoint c4.rare.t2.all : "Rare Endgame Items - T2" : "Gear - Regular Rares"
		
		Show T2 { !rares_t12; !GR1; %D3; BaseType == derived.rares.gear.t2; }

#!! Waypoint c4.rare.idhandling.all :  "Rare Endgame Items - Identified Item Handling" : "Gear - Regular Rares"

		Show IdentifiedItemHandling { !exotics_t4; !GS; %D0; Identified True; Clean(); Class == classes_equip; }

#!! Waypoint c4.rare.t3.all : "Rare Endgame Items - t3" : "Gear - Regular Rares"

		Show T3 { !rares_t3; !GR2; %D2; BaseType == derived.rares.gear.t3; }

#!! Waypoint c4.rare.t4.all : "Rare Endgame Items - T4" : "Gear - Regular Rares"

		Show T4 { !rares_t4; !GR3; %D1; BaseType == derived.rares.gear.t4; }
	}
}

#===============================================================================================================
# [[0200]] Endgame - Crafting
#===============================================================================================================

#------------------------------------
# [1234] Early Endgame Crafting projects
#------------------------------------

# Minimal list of bases crafting. This list is really not conclusive, but you can adjust it yourself on filterblade or here.
# Having this list too long will lead to being too flooded with these drops.

Section EarlyEndgameCrafting : Auto("normalcraft->extra"), Rarity <= Magic, AreaLevel <= 75, AreaLevel >= 68, Clean()
{
	ShowD EarlyCraftOptional { !crafting_early; !GEX; %D0; BaseType == bases.crafting.early; }
	Show EarlyEndgame4Link { !crafting_early; !GEX; %D1; LinkedSockets >= 4; Rarity <= Rare; Class == classes_armor_noshields; }
}

#------------------------------------
# [1234] Crafting Matrix
#------------------------------------
Section EndgameCraftingBases : Clean()
{
	#!! Waypoint c5.gear.crafting86.all : "Crafting Bases - High level basetypes - ILVL86" : "Gear - Crafting Bases"

	Section CraftingBases : Auto("crafting->generalgear"), Rarity <= Rare
	{
		# Level 86 crafting bases
		Show t1_86 { !crafting_t1; !G3;  %D5; ItemLevel >= 86; BaseType == derived.crafting.levelgroup86.t1; }
		Show t2_86 { !crafting_t2; !GEX; %D4; ItemLevel >= 86; BaseType == derived.crafting.levelgroup86.t2; }
		Show t3_86 { !crafting_t2; !GEX; %D3; ItemLevel >= 86; BaseType == derived.crafting.levelgroup86.t3; }

		# Level 85 crafting bases
		Show t1_85 { !crafting_t1; !G3;  %D4; ItemLevel >= 85; BaseType == derived.crafting.levelgroup85.t1; }
		Show t2_85 { !crafting_t2; !GEX; %D3; ItemLevel >= 85; BaseType == derived.crafting.levelgroup85.t2; }
		Show t3_85 { !crafting_t2; !GEX; %D2; ItemLevel >= 85; BaseType == derived.crafting.levelgroup85.t3; }

		# Level 84 crafting bases
		Show t1_84 { !crafting_t1; !G3;  %D4; ItemLevel >= 84; BaseType == derived.crafting.levelgroup84.t1; }
		Show t2_84 { !crafting_t2; !GEX; %D3; ItemLevel >= 84; BaseType == derived.crafting.levelgroup84.t2; }
		Show t3_84 { !crafting_t2; !GEX; %D2; ItemLevel >= 84; BaseType == derived.crafting.levelgroup84.t3; }

		# Level 83 crafting bases
		Show t1_83 { !crafting_t1; !G3;  %D4; ItemLevel >= 83; BaseType == derived.crafting.levelgroup83.t1; }
		Show t2_83 { !crafting_t2; !GEX; %D3; ItemLevel >= 83; BaseType == derived.crafting.levelgroup83.t2; }
		Show t3_83 { !crafting_t2; !GEX; %D2; ItemLevel >= 83; BaseType == derived.crafting.levelgroup83.t3; }
	}
}

#===============================================================================================================
# [[0200]] Chancing Bases
#===============================================================================================================
#!! Waypoint c5.chancing : "Chancing bases" : "Recipes and Linked Gear"

Section Chancing : Clean(), Rarity Normal, Auto("chancing"), !crafting_chance, !GEX
{
	Show hh { %D1; BaseType == bases.chancing.higher; }
	Show t2 { %D1; BaseType == bases.chancing.any; }
}

#===============================================================================================================
# [[0200]] Endgame Flasks & Tinctures
#===============================================================================================================

#!! Waypoint c6.flasks.all : "Endgame Flasks - All non-unique" : "Flasks and Tinctures"

Section EndgameTinctures : Auto("EndgameTinctures"), Rarity <= Magic, AreaLevel >= 68, Class == "Tinctures"
{
	Show OverQual1          { !exotics_t1; !G2; %D9; Clean(); ItemLevel >= 82; Quality >= 26; }
	Show OverQual2          { !exotics_t2; !G3; %D8; Clean(); ItemLevel >= 82; Quality >= 21; }
	Show Tinc85  			{ !flasks_t2util; !G4; %D5; ItemLevel >= 85; }
	Show Tinc82  			{ !flasks_t3util; !G4; %D4; ItemLevel >= 82; }
	Show Any  				{ !flasks_t3util; !G4; %D3; Empty(); }
}

Section EndgameFlasks : Auto("EndgameFlasks"), Rarity <= Magic, AreaLevel >= 68
{
#------------------------------------
# [2701] Endgame Flasks
#------------------------------------
	
	Section OverQualityFlasks : !GEX
	{
		Show OverQualCorrupted  { !flasks_utilcorr; !G3; %D4; Corrupted True; Quality >= 30; Rarity Magic; Class == class_utilFlasks; BaseType == bases.flask.utilityassorted; }
		Show OverQualUtil1  { !exotics_t1; !G2; %D9; Clean(); ItemLevel >= 84; Quality >= 26; Class == class_utilFlasks; }
		Show OverQualUtil2  { !exotics_t2; !G4; %D8; Clean(); ItemLevel >= 82; Quality >= 21; Class == class_utilFlasks; BaseType == bases.flask.utilityassorted; }
		Show OverQualLife1  { !exotics_t1; !G3; %D6; Clean(); ItemLevel >= 82; Quality >= 30; BaseType == bases.flask.lifemanaassorted; }
		Show OverQualLife2  { !exotics_t2; !G4; %D5; Clean(); ItemLevel >= 82; Quality >= 21; BaseType == bases.flask.lifemanaassorted; }
	}

	#!! Waypoint c6.flasks.eg : "Endgame Flasks - High level utility and life flasks" : "Flasks and Tinctures"
	Section SuperEndgameFlasks : Clean(), !GEX
	{
		Show Utility85  { !flasks_t1util; !G3; %D5; ItemLevel >= 85; Class == class_utilFlasks; BaseType == bases.flask.utilityassorted; }
		Show Utility84  { !flasks_t2util; !G4; %D4; ItemLevel >= 84; Class == class_utilFlasks; BaseType == bases.flask.utilityassorted; }
		Show Utility82  { !flasks_t3util; !G4; %D4; ItemLevel >= 82; Class == class_utilFlasks; }
		Show LifeMana82 { !flasks_qhigh; !G5; %D3; ItemLevel >= 82; Quality >= 10; BaseType == bases.flask.lifemanaassorted; Class == class_lifemanaflasks; }
	}
#------------------------------------
# [2701] Quality High
#------------------------------------
	#!! Waypoint c6.flasks.others : "Endgame Flasks - Other flasks" : "Flasks and Tinctures"
	Section 20QualEndgameFlasks : Quality >= 20, Rarity Normal, !G5
	{
		Show Any20QualFlask { !flasks_qmax; %D2; Class == class_flasks; }
	}

#------------------------------------
# [2701] Quality Low
#------------------------------------
	Section QualityEndgameFlasks
	{
		ShowD QualityHigh { !flasks_qhigh; !G6H; %D1; Class == class_flasklikes; Quality >= 10; AreaLevel <= 77; }
		ShowD QualityLow  { !leveling_qualityflask; !G6; %D0; Class == class_flasklikes; Quality >= 1; AreaLevel <= 77; }
	}
#------------------------------------
# [2701] Utility flasks
#------------------------------------
	Section UtilityEndgameFlasks : Clean(), !flasks_t3util
	{
		Show EarlyMappingFlasks { !G4; %D4; Class == class_utilFlasks; AreaLevel >= 68; AreaLevel <= 75;  }
		Show AnyUtility 	{ !G4; %D3; Class == class_utilFlasks; AreaLevel >= 68; }
	}
#------------------------------------
# [2705] Early mapping life/mana/utility flasks
#------------------------------------
	Section EarlyMappingLifeManaFlasks : BaseType == bases.flask.lifemanaassorted, Clean()
	{
		Show EarlyMappingLifeMana { !crafting_early; !G7H; %D2; AreaLevel <= 70; }
	}
}

#===============================================================================================================
# [[0200]] Misc Rules
#===============================================================================================================
#!! Waypoint c6.misc.others : "SpecialGear - Overquality items and optional animated weapon module" : "Gear - Exotic"

Section AnimatedWeapons : Auto("AnimatedWeapons"), !utility_aw, !GEX
{
	ShowD normalmelee  { Rarity Normal; Class == classes_weapons_melee;}
	ShowD normalranged { Rarity Normal; Class == classes_weapons_ranged;}
	ShowD magicmelee   { Rarity Magic; Class == classes_weapons_melee;}
	ShowD magicranged  { Rarity Magic; Class == classes_weapons_ranged;}
}


#------------------------------------
# [1234] RGB Endgame
#------------------------------------
#!! Waypoint c6.recipes.rgb.all : "Recipes - Endgame chromatic recipes (normal and magic RGBs)" : "Recipes and Linked Gear"

Section RGBendgame : SocketGroup "RGB", Rarity <= Rare, AreaLevel >= 68, AreaLevel <= 83, Auto("EndgameRGB"), !links_recipe
{
	# Legacy RBG rules, will be deleted once confirmed no longer important

	ShowD RGBSmall1	{ !G6H; %D5; Width 2; Height 2; }
	ShowD RGBSmall2	{ !G6H; %D5; Width 1; Height <=4; }
	ShowD RGBLarge	{ !G6;  %D4; Width 2; Height 4; }
	ShowD RGBMedium	{ !G6;  %D4; Width 2; Height 3; }
}

#------------------------------------
# [1234] Remaining Rares
#------------------------------------
#!! Waypoint c6.rares.remaining : "Rares - lowest tier" : "Gear - Regular Rares"

Section EndgameRareGear : Auto("rr"), Rarity Rare, ItemLevel >= 68
{
	Show t5 { !rares_t5; !GR4; %D1; Class == classes_nonJwlryEquip; }
}

#===============================================================================================================
# [[0200]] Hide Layer 1 - Rare & Magic Gear
#===============================================================================================================
#!! Waypoint c6.hidelayer.endgame : "HIDELAYER - all endgame and magic and normal items"

Section HideLayer : Auto("HideLayer"), !utility_layer
{
	Hide NormalMagicEndgame { AreaLevel >= 68; Rarity < Rare; Class == classes_equip + class_utilFlasks; }
	Hide RaresEndgame { ItemLevel >= 68; Rarity Rare; Class == classes_equip; }
}

#===============================================================================================================
# [[0200]] Jewels
#===============================================================================================================
#!! Waypoint c7.jewels.identified : "Jewels - Identified with interesting mods" : "Jewels and Cluster Jewels"

Section Jewels
{
#------------------------------------
# [1234] Special Cases
#------------------------------------

	Section SpecialJewels : Auto("jewels->special"), !GS
	{
		## Any rare corrupted, normal or abyss jewel (2x corruptions are handled above)
		Section CorruptedJewels : Corrupted True, Rarity Rare, CorruptedMods >= 1
		{
			Show 1modcorrupted { !jewels_specialcorrupt; %D4; BaseType == allCommonJewels; }
		}

		## Heist dropped 1-mod magic jewels with useful mods
		Section IdedUncorruptedJewels : Identified True, Rarity <= Rare, BaseType == genericJewels;
		{
			Show 1moduncorrupted { !exotics_t3; %D4; HasExplicitMod "Shimmering" "Vivid" "Stalwart" "Resplendent" "Expediting"; }
		}

		## Adorned class magic corrupted modded jewels
		Section AdornedJewels : Rarity Magic, CorruptedMods >= 1, !GI
		{
			Show Any { !jewels_special; %D3; Corrupted True; BaseType == genericJewels; }
		}
	}

#------------------------------------
# [1234] Leveling Exceptions
#------------------------------------
#!! Waypoint c7.jewels.leveling : "Jewels - Leveling Overrides" : "Jewels and Cluster Jewels"
	Section JewelsLeveling : Auto("jewels->leveling"), ItemLevel <= 67, Rarity <= Magic, !jewels_abysslvl
	{
		Show Abyss 		{ !GI; %D3; BaseType == abyssJewels; }
		Show Generic 	{ !GI; %D3; BaseType == genericJewels; }
	}

#------------------------------------
# [1234] Abyss Jewels
#------------------------------------
#!! Waypoint c7.jewels.abyss.all : "Jewels - Abyss Jewels" : "Jewels and Cluster Jewels"
	Section AbyssJewels : Class == "Abyss Jewels", Auto("jewels->abyss")
	{
		Show ExtraModCorruptedAbyssJewel { !exotics_t2; !G3; %H7; Rarity Rare; Corrupted True; Mod >=5 "a" "e" "i" "o" "u" "y"; }

		Show CorruptedAbyssJewel { !jewels_rareveryhigh; !G4; %H5; Rarity Rare; Corrupted True; }

		Show VeryHighRare  { !jewels_rareveryhigh; !G4;  %H5;  Rarity Rare; ItemLevel >= 86; }
		Show VeryHighMagic { !jewels_abyss1; !G4; !GI;  %HS4;  Rarity <= Magic; ItemLevel >= 86; }
		
		Show HighRare      { !jewels_rarehigh; !G5H;  %HS4; Rarity Rare; ItemLevel >= 82; }
		Show HighMagic     { !jewels_abyss2; !G6H; !GI; %HS3; Rarity <= Magic; ItemLevel >= 82; }
		Show AnyRare       { !jewels_rare; !G5H; %HS3; Rarity Rare; }
		Show AnyMagic      { !jewels_abysslvl; !G6H; !GI;  %H2; Rarity <= Magic; }
	}
#------------------------------------
# [1234] Generic Jewels
#------------------------------------
#!! Waypoint c7.jewels.generic.all : "Jewels - Generic Jewels"
	Section GenericJewels : BaseType == genericJewels, Auto("jewels->generic")
	{
		Show AnyRare  { !jewels_rare; !G5H; %HS3; Rarity Rare; }
		Show AnyMagic { !jewels_abysslvl; !G6H; !GI; %H2; Rarity <= Magic; }
	}

#------------------------------------
# [1234] Cluster Jewels: Eco-Based-Large
#------------------------------------
#!! Waypoint c7.jewels.cluster.all : "Jewels - Cluster - Economy-Based-Tiering" : "Jewels and Cluster Jewels"

	Section ClusterJewelsEconomy : Auto("jewels->clustereco"), Rarity <= Rare
	{
		Section T1clusterjewels : !apex_sjewel, !G2
		{
			## Large N12 T1
			Show N12_I84_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 12; EnchantmentPassiveNode == jewels.cluster.N12_I84_T1; }
			Show N12_I75_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 12; EnchantmentPassiveNode == jewels.cluster.N12_I75_T1; }
			Show N12_I68_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 12; EnchantmentPassiveNode == jewels.cluster.N12_I68_T1; }

			## Large N11 T1
			Show N11_I84_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 11; EnchantmentPassiveNode == jewels.cluster.N11_I84_T1; }
			Show N11_I75_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 11; EnchantmentPassiveNode == jewels.cluster.N11_I75_T1; }
			Show N11_I68_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 11; EnchantmentPassiveNode == jewels.cluster.N11_I68_T1; }

			## Large N10 T1
			Show N10_I84_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 10; EnchantmentPassiveNode == jewels.cluster.N10_I84_T1; }
			Show N10_I75_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 10; EnchantmentPassiveNode == jewels.cluster.N10_I75_T1; }
			Show N10_I68_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 10; EnchantmentPassiveNode == jewels.cluster.N10_I68_T1; }

			## Large N9 T1
			Show N9_I84_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 9; EnchantmentPassiveNode == jewels.cluster.N9_I84_T1; }
			Show N9_I75_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 9; EnchantmentPassiveNode == jewels.cluster.N9_I75_T1; }
			Show N9_I68_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 9; EnchantmentPassiveNode == jewels.cluster.N9_I68_T1; }

			## Large N8 T1
			Show N8_I84_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 8; EnchantmentPassiveNode == jewels.cluster.N8_I84_T1; }
			Show N8_I75_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 8; EnchantmentPassiveNode == jewels.cluster.N8_I75_T1; }
			Show N8_I68_T1 { BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 8; EnchantmentPassiveNode == jewels.cluster.N8_I68_T1; }

			## Medium N6 T1
			Show N6_I84_T1 { BaseType == "Medium Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 6; EnchantmentPassiveNode == jewels.cluster.N6_I84_T1; }
			Show N6_I75_T1 { BaseType == "Medium Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 6; EnchantmentPassiveNode == jewels.cluster.N6_I75_T1; }
			Show N6_I68_T1 { BaseType == "Medium Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 6; EnchantmentPassiveNode == jewels.cluster.N6_I68_T1; }

			## Medium N4-5 T1
			Show N4_I84_T1 { BaseType == "Medium Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum <= 5; EnchantmentPassiveNode == jewels.cluster.N4_I84_T1; }
			Show N4_I75_T1 { BaseType == "Medium Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum <= 5; EnchantmentPassiveNode == jewels.cluster.N4_I75_T1; }
			Show N4_I68_T1 { BaseType == "Medium Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum <= 5; EnchantmentPassiveNode == jewels.cluster.N4_I68_T1; }

			## Small N3 T1
			Show N3_I84_T1 { BaseType == "Small Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 3; EnchantmentPassiveNode == jewels.cluster.N3_I84_T1; }
			Show N3_I75_T1 { BaseType == "Small Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 3; EnchantmentPassiveNode == jewels.cluster.N3_I75_T1; }
			Show N3_I68_T1 { BaseType == "Small Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 3; EnchantmentPassiveNode == jewels.cluster.N3_I68_T1; }

			## Small N2 T1
			Show N2_I84_T1 { BaseType == "Small Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 2; EnchantmentPassiveNode == jewels.cluster.N2_I84_T1; }
			Show N2_I75_T1 { BaseType == "Small Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 2; EnchantmentPassiveNode == jewels.cluster.N2_I75_T1; }
			Show N2_I68_T1 { BaseType == "Small Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 2; EnchantmentPassiveNode == jewels.cluster.N2_I68_T1; }
		}

		Section T2clusterjewels : !jewels_t2, !G3
		{
			## Large N12 T2
			Show N12_I84_T2 { %D8; BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 12; EnchantmentPassiveNode == jewels.cluster.N12_I84_T2; }
			Show N12_I75_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 12; EnchantmentPassiveNode == jewels.cluster.N12_I75_T2; }
			Show N12_I68_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 12; EnchantmentPassiveNode == jewels.cluster.N12_I68_T2; }

            ## Large N11 T2
			Show N11_I84_T2 { %D8; BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 11; EnchantmentPassiveNode == jewels.cluster.N11_I84_T2; }
			Show N11_I75_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 11; EnchantmentPassiveNode == jewels.cluster.N11_I75_T2; }
			Show N11_I68_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 11; EnchantmentPassiveNode == jewels.cluster.N11_I68_T2; }

			## Large N10 T2
			Show N10_I84_T2 { %D8; BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 10; EnchantmentPassiveNode == jewels.cluster.N10_I84_T2; }
			Show N10_I75_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 10; EnchantmentPassiveNode == jewels.cluster.N10_I75_T2; }
			Show N10_I68_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 10; EnchantmentPassiveNode == jewels.cluster.N10_I68_T2; }

			## Large N9 T2
			Show N9_I84_T2 { %D8; BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 9; EnchantmentPassiveNode == jewels.cluster.N9_I84_T2; }
			Show N9_I75_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 9; EnchantmentPassiveNode == jewels.cluster.N9_I75_T2; }
			Show N9_I68_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 9; EnchantmentPassiveNode == jewels.cluster.N9_I68_T2; }

			## Large N8 T2
			Show N8_I84_T2 { %D8; BaseType == "Large Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 8; EnchantmentPassiveNode == jewels.cluster.N8_I84_T2; }
			Show N8_I75_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 8; EnchantmentPassiveNode == jewels.cluster.N8_I75_T2; }
			Show N8_I68_T2 { %D7; BaseType == "Large Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 8; EnchantmentPassiveNode == jewels.cluster.N8_I68_T2; }

			## Medium N6 T2
			Show N6_I84_T2 { %D8; BaseType == "Medium Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 6; EnchantmentPassiveNode == jewels.cluster.N6_I84_T2; }
			Show N6_I75_T2 { %D7; BaseType == "Medium Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 6; EnchantmentPassiveNode == jewels.cluster.N6_I75_T2; }
			Show N6_I68_T2 { %D7; BaseType == "Medium Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 6; EnchantmentPassiveNode == jewels.cluster.N6_I68_T2; }

			## Medium N4-5 T2
			Show N4_I84_T2 { %D8; BaseType == "Medium Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum <= 5; EnchantmentPassiveNode == jewels.cluster.N4_I84_T2; }
			Show N4_I75_T2 { %D7; BaseType == "Medium Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum <= 5; EnchantmentPassiveNode == jewels.cluster.N4_I75_T2; }
			Show N4_I68_T2 { %D7; BaseType == "Medium Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum <= 5; EnchantmentPassiveNode == jewels.cluster.N4_I68_T2; }

			## Small N3 T2
			Show N3_I84_T2 { %D8; BaseType == "Small Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 3; EnchantmentPassiveNode == jewels.cluster.N3_I84_T2; }
			Show N3_I75_T2 { %D7; BaseType == "Small Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 3; EnchantmentPassiveNode == jewels.cluster.N3_I75_T2; }
			Show N3_I68_T2 { %D7; BaseType == "Small Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 3; EnchantmentPassiveNode == jewels.cluster.N3_I68_T2; }

			## Small N2 T2
			Show N2_I84_T2 { %D8; BaseType == "Small Cluster Jewel"; ItemLevel >= 84; EnchantmentPassiveNum = 2; EnchantmentPassiveNode == jewels.cluster.N2_I84_T2; }
			Show N2_I75_T2 { %D7; BaseType == "Small Cluster Jewel"; ItemLevel >= 75; ItemLevel <= 83; EnchantmentPassiveNum = 2; EnchantmentPassiveNode == jewels.cluster.N2_I75_T2; }
			Show N2_I68_T2 { %D7; BaseType == "Small Cluster Jewel"; ItemLevel >= 68; ItemLevel <= 74; EnchantmentPassiveNum = 2; EnchantmentPassiveNode == jewels.cluster.N2_I68_T2; }
